---
import { getImage } from 'astro:assets';
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import geistFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import socialCard from '../assets/social-card.svg';
import { site } from '../config/site';
import { canIndex } from '../config/seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Above-the-fold image to fetch early, such as the hero video's poster. */
  preloadImage?: string;
}

const {
  title = site.title,
  description = site.description,
  noindex = false,
  preloadImage,
} = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const socialImage = await getImage({
  src: socialCard,
  format: 'png',
  width: 1200,
  height: 630,
});
const socialImagePath = socialImage.src;
const socialImageUrl = Astro.site
  ? new URL(socialImagePath, Astro.site)
  : undefined;
const indexable = canIndex(Astro.site) && !noindex;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  description: site.description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Windows 10, Windows 11',
  softwareVersion: site.version,
  isAccessibleForFree: true,
  license: 'https://spdx.org/licenses/AGPL-3.0-only.html',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  ...(canonical && { url: canonical.href }),
  ...(site.installer && { downloadUrl: site.installer.href }),
  ...(site.installer && { fileSize: site.installer.size }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="theme-color" content="#f8f8f6" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={indexable ? 'index, follow' : 'noindex, nofollow'}
    />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="preload"
      href={geistFont}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    {preloadImage && (
      <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />
    )}
    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Foldex. Files, without the friction. A native, open-source file explorer for Windows."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {!noindex && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
    <script>
      // Reveal marked content once, as it first scrolls into view.
      const reveal = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-in');
            reveal.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      document
        .querySelectorAll('[data-reveal]')
        .forEach((el) => reveal.observe(el));
    </script>
  </body>
</html>
