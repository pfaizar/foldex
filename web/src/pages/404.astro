---
import PageLayout from '../layouts/PageLayout.astro';
import Aura from '../components/Aura.astro';
import Icon from '../components/ui/Icon.astro';
---

<PageLayout
  title="Page not found — Foldex"
  description="This page could not be found. Return to Foldex."
  noindex
>
  <main id="main" class="not-found" tabindex="-1">
    <Aura palette="dusk" seed={4} />
    <div class="wrap copy">
      <h1>404</h1>
      <p>This folder is empty.</p>
      <a class="button back" href="/">
        <Icon name="arrow-right" size={15} />
        Back to Foldex
      </a>
    </div>
  </main>
</PageLayout>

<style>
  .not-found {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    overflow: hidden;
    color: #f4f2ee;
  }
  .copy {
    position: relative;
    text-align: center;
  }
  h1 {
    font-size: clamp(120px, 22vw, 280px);
    font-weight: 380;
    letter-spacing: -0.06em;
    line-height: 0.85;
  }
  p {
    margin-top: 20px;
    color: #f4f2eebf;
    font-size: 20px;
  }
  .back {
    margin-top: 32px;
    background: #f4f2ee;
    color: var(--ink);
  }
  .back:hover {
    background: #fff;
  }
  .back :global(svg) {
    rotate: 180deg;
  }
</style>
