---
import PageLayout from '../layouts/PageLayout.astro';
import DitherField from '../components/DitherField.astro';
import Icon from '../components/ui/Icon.astro';
---

<PageLayout
  title="Page not found — Foldex"
  description="This page could not be found. Return to Foldex."
  noindex
>
  <main id="main" class="not-found" tabindex="-1">
    <DitherField />
    <div class="wrap copy">
      <h1 class="pixel">404</h1>
      <p>This folder is empty.</p>
      <a class="back" href="/">
        <Icon name="arrow-right" size={16} />
        Back to Foldex
      </a>
    </div>
  </main>
</PageLayout>

<style>
  .not-found {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    background: var(--night);
    color: #f1f4f4;
  }
  .copy {
    position: relative;
  }
  h1 {
    font-size: clamp(120px, 24vw, 320px);
    line-height: 0.8;
  }
  p {
    margin-top: 24px;
    color: var(--night-text);
    font-size: 20px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    margin-top: 32px;
    padding: 0 20px;
    border-radius: 6px;
    background: var(--yellow);
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 -3px var(--folder-back);
  }
  .back :global(svg) {
    rotate: 180deg;
  }
</style>
