---
// A soft field of colour that folds and drifts slowly, like light through
// frosted glass, with film grain on top. It draws at a fraction of its size and
// is smoothed when scaled up, which is what makes it soft; the grain is a
// separate full-resolution layer. Without WebGL it keeps a still gradient of
// the same colours.
import { auras, type AuraName } from '../data/auras';

interface Props {
  palette?: AuraName;
  /** Shifts the pattern so neighbouring fields don't move in step. */
  seed?: number;
  class?: string;
}

const { palette = 'fog', seed = 0, class: className, ...rest } = Astro.props;
const colors = auras[palette];
const style = colors.map((color, i) => `--c${i}:${color}`).join(';');
---

<div
  {...rest}
  class:list={['aura', className]}
  data-aura
  data-colors={colors.join(',')}
  data-seed={seed}
  style={style}
  aria-hidden="true"
>
  <canvas></canvas>
</div>

<script>
  const vertex = `
    attribute vec2 p;
    void main() { gl_Position = vec4(p, 0.0, 1.0); }
  `;
  const fragment = `
    precision highp float;
    uniform vec2 size;
    uniform float time;
    uniform float seed;
    uniform vec3 c0;
    uniform vec3 c1;
    uniform vec3 c2;
    uniform vec3 c3;

    float hash(vec2 p) {
      return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
    }
    float noise(vec2 p) {
      vec2 i = floor(p);
      vec2 f = fract(p);
      f = f * f * (3.0 - 2.0 * f);
      return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x),
                 mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
    }
    float fbm(vec2 p) {
      float v = 0.0;
      float a = 0.5;
      for (int i = 0; i < 4; i++) {
        v += a * noise(p);
        p = p * 2.02 + 17.0;
        a *= 0.5;
      }
      return v;
    }

    void main() {
      vec2 uv = gl_FragCoord.xy / size;
      vec2 p = vec2(uv.x * size.x / size.y, uv.y) * 1.1 + seed * 3.7;
      float t = time * 0.035;

      // Two rounds of domain warping fold the noise into broad, silky shapes.
      vec2 q = vec2(fbm(p + vec2(0.0, t)), fbm(p + vec2(5.2, 1.3) - t));
      vec2 r = vec2(fbm(p + 2.4 * q + vec2(1.7, 9.2) + 0.7 * t),
                    fbm(p + 2.4 * q + vec2(8.3, 2.8) - 0.6 * t));
      float f = smoothstep(0.28, 0.72, fbm(p + 2.2 * r));

      // Deep base, a shadow tone, the mid colour, then a light that only
      // breaks through where the folds crest.
      vec3 col = mix(c0, c1, smoothstep(0.0, 0.4, f));
      col = mix(col, c2, smoothstep(0.3, 0.75, f));
      col = mix(col, c3, smoothstep(0.55, 0.9, f) * smoothstep(0.3, 0.65, r.y));
      // A soft falloff toward the corners, like a lens.
      vec2 d = uv - 0.5;
      col *= 1.0 - 0.36 * dot(d, d);
      gl_FragColor = vec4(col, 1.0);
    }
  `;

  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const rgb = (hex: string) =>
    [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255) as [
      number,
      number,
      number,
    ];
  // Canvas pixels per CSS pixel: low, so the colour stays soft when scaled up.
  const SCALE = 1 / 6;

  function start(root: HTMLElement) {
    const canvas = root.querySelector('canvas')!;
    const gl = canvas.getContext('webgl', { antialias: false, alpha: false });
    if (!gl) return;

    const compile = (type: number, source: string) => {
      const shader = gl.createShader(type)!;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      return shader;
    };
    const program = gl.createProgram()!;
    gl.attachShader(program, compile(gl.VERTEX_SHADER, vertex));
    gl.attachShader(program, compile(gl.FRAGMENT_SHADER, fragment));
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;
    gl.useProgram(program);

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]),
      gl.STATIC_DRAW,
    );
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
    const uniform = (name: string) => gl.getUniformLocation(program, name);
    const uSize = uniform('size');
    const uTime = uniform('time');
    root.dataset.colors!.split(',').forEach((hex, i) => {
      gl.uniform3f(uniform(`c${i}`), ...rgb(hex));
    });
    gl.uniform1f(uniform('seed'), Number(root.dataset.seed));

    const begin = performance.now();
    let frame = 0;
    let visible = false;

    const resize = () => {
      const w = Math.max(1, Math.ceil(root.clientWidth * SCALE));
      const h = Math.max(1, Math.ceil(root.clientHeight * SCALE));
      if (canvas.width === w && canvas.height === h) return;
      canvas.width = w;
      canvas.height = h;
      gl.viewport(0, 0, w, h);
      gl.uniform2f(uSize, w, h);
    };
    const draw = (seconds: number) => {
      gl.uniform1f(uTime, seconds);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };
    const loop = (now: number) => {
      draw((now - begin) / 1000 + 30);
      frame = requestAnimationFrame(loop);
    };
    const sync = () => {
      cancelAnimationFrame(frame);
      resize();
      if (reduced.matches || !visible || document.hidden) draw(30);
      else frame = requestAnimationFrame(loop);
    };

    new ResizeObserver(sync).observe(root);
    new IntersectionObserver((entries) => {
      visible = entries.some((entry) => entry.isIntersecting);
      sync();
    }).observe(root);
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);
    sync();
    root.classList.add('is-live');
  }

  // Each field gets its WebGL context only once it comes near the screen.
  const pending = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        pending.unobserve(entry.target);
        start(entry.target as HTMLElement);
      }
    },
    { rootMargin: '400px 0px' },
  );
  document
    .querySelectorAll<HTMLElement>('[data-aura]')
    .forEach((root) => pending.observe(root));
</script>

<style>
  .aura {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(60% 70% at 70% 30%, var(--c3), transparent 70%),
      radial-gradient(70% 80% at 25% 70%, var(--c2), transparent 75%),
      linear-gradient(160deg, var(--c1), var(--c0));
  }
  canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms ease-out;
  }
  .is-live canvas {
    opacity: 1;
  }
  /* Film grain, at full resolution over the soft colour. */
  .aura::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/grain.png') 0 0 / 160px 160px;
    mix-blend-mode: overlay;
    opacity: var(--grain, 0.32);
    pointer-events: none;
  }
</style>
