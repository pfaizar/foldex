---
import Folder from './ui/Folder.astro';
import { navigation, site } from '../config/site';

const project = [
  site.repository && { label: 'GitHub', href: site.repository },
  site.download && { label: 'Releases', href: site.download },
  site.repository && {
    label: 'Issues',
    href: site.repository.replace(/\/$/, '') + '/issues',
  },
  { label: 'License', href: site.license },
].filter((link) => !!link);
---

<footer class="site-footer">
  <div class="wrap top">
    <div class="brand">
      <a href="#top">
        <Folder size={22} />
        <span>Foldex</span>
      </a>
      <p>Files, without the friction.</p>
    </div>
    <nav class="links" aria-label="Footer">
      <div>
        <p class="head">Product</p>
        <ul>
          {navigation.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="head">Project</p>
        <ul>
          {project.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>
  <div class="wrap bottom">
    <span>Foldex {site.version}. Made with Rust.</span>
    <span>
      Not affiliated with Microsoft. Windows is a trademark of Microsoft.
    </span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 48px;
    padding: clamp(48px, 6vw, 80px) 0;
  }
  .brand a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: 560;
    letter-spacing: -0.03em;
  }
  .brand p {
    margin-top: 12px;
    color: var(--muted);
  }
  .links {
    display: flex;
    gap: clamp(48px, 8vw, 120px);
  }
  .head {
    margin-bottom: 14px;
    color: var(--faint);
    font-size: 13px;
  }
  ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    color: var(--ink-2);
    transition: color 150ms var(--ease-out);
  }
  .links a:hover {
    color: var(--ink);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 20px 0 32px;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 12px;
  }
</style>
