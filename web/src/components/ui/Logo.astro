---
// The Foldex app icon, from assets/brand/foldex.png.
import { Image } from 'astro:assets';
import logo from '../../assets/foldex.png';

interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
---

<Image
  src={logo}
  alt=""
  width={size}
  height={size}
  densities={[1, 2, 3]}
  class:list={['logo', className]}
/>

<style>
  .logo {
    flex-shrink: 0;
  }
</style>
