---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'a'> {
  variant?: 'primary' | 'secondary' | 'text';
  small?: boolean;
}
const {
  variant = 'primary',
  small = false,
  class: className,
  ...attributes
} = Astro.props;
---

<a
  class:list={[
    'button',
    'button--' + variant,
    { 'button--small': small },
    className,
  ]}
  {...attributes}
>
  <slot />
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding-inline: 19px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.2;
    white-space: nowrap;
    transition:
      background 150ms ease,
      border-color 150ms ease;
  }
  .button--primary {
    background: #111;
    color: #fff;
  }
  .button--primary:hover {
    background: #333;
  }
  .button--secondary {
    border-color: #e0e0e0;
    background: transparent;
    color: #242424;
  }
  .button--secondary:hover {
    border-color: #bfbfbf;
    background: #f1f1f1;
  }
  .button--text {
    padding-inline: 0;
    color: var(--text);
  }
  .button--text:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .button--small {
    min-height: 30px;
    padding-inline: 14px;
    font-size: 12px;
  }
</style>
