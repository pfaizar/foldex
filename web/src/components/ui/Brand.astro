---
import { Image } from 'astro:assets';
import logo from '../../assets/foldex.png';
---

<a class="brand" href="/" aria-label="Foldex home">
  <Image
    src={logo}
    width={27}
    height={27}
    densities={[1, 2]}
    alt=""
    loading="eager"
  />
  <span>Foldex</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    width: fit-content;
    color: var(--text);
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.8px;
  }
  .brand img {
    flex-shrink: 0;
  }
</style>
