---
import Folder from './ui/Folder.astro';
import Icon from './ui/Icon.astro';
import { navigation, site } from '../config/site';

const download = site.installer?.href ?? site.download;
---

<header class="site-header">
  <nav class="wrap bar" aria-label="Primary">
    <a class="brand" href="#top" aria-label="Foldex, back to top">
      <Folder size={22} />
      <span>Foldex</span>
    </a>
    <ul class="links">
      {navigation.map(({ label, href }) => (
        <li>
          <a href={href}>{label}</a>
        </li>
      ))}
    </ul>
    <div class="end">
      {site.repository && (
        <a class="source" href={site.repository} aria-label="Foldex on GitHub">
          <Icon name="github" size={18} />
        </a>
      )}
      {download && (
        <a class="button get" href={download}>
          Download
        </a>
      )}
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const update = () => header.classList.toggle('is-scrolled', scrollY > 8);
  addEventListener('scroll', update, { passive: true });
  update();
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 50;
    inset: 0 0 auto;
    height: var(--nav);
    border-bottom: 1px solid transparent;
    transition:
      background-color 200ms var(--ease-out),
      border-color 200ms var(--ease-out);
  }
  .site-header.is-scrolled {
    border-color: var(--line);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: saturate(1.6) blur(16px);
    backdrop-filter: saturate(1.6) blur(16px);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 100%;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: 560;
    letter-spacing: -0.03em;
  }
  .links {
    display: flex;
    gap: 4px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: block;
    padding: 6px 12px;
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 14px;
    transition:
      color 150ms var(--ease-out),
      background-color 150ms var(--ease-out);
  }
  .links a:hover {
    background: #0e10120a;
    color: var(--ink);
  }
  .end {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .source {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    color: var(--ink-2);
    transition: background-color 150ms var(--ease-out);
  }
  .source:hover {
    background: #0e10120a;
    color: var(--ink);
  }
  .get {
    height: 36px;
    padding: 0 16px;
    font-size: 14px;
  }
  @media (max-width: 760px) {
    .links {
      display: none;
    }
    .end {
      margin-left: auto;
    }
  }
</style>
