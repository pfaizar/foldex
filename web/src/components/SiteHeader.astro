---
import { navigation } from '../config/site';
import Brand from './ui/Brand.astro';
import Button from './ui/Button.astro';
---

<header class="site-header">
  <div class="header-inner">
    <Brand />
    <nav class="desktop-nav" aria-label="Main navigation">
      {navigation.map(({ label, href }) => (
        <a href={href}>{label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <Button href="#get-foldex" small>
        Get Foldex
      </Button>
      <details class="mobile-menu">
        <summary aria-label="Toggle navigation">
          <span></span>
          <span></span>
        </summary>
        <nav aria-label="Mobile navigation">
          {navigation.map(({ label, href }) => (
            <a href={href}>{label}</a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  if (menu) {
    menu.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => {
        menu.open = false;
      }),
    );
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target))
        menu.open = false;
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 10;
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 50px;
    width: min(1160px, calc(100% - 96px));
    min-height: 58px;
    margin-inline: auto;
  }
  .desktop-nav {
    display: flex;
    gap: 27px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    color: #363636;
    font-size: 13px;
  }
  nav a:hover {
    color: #000;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 17px;
    margin-left: auto;
  }
  .mobile-menu {
    display: none;
  }
  @media (max-width: 720px) {
    .header-inner {
      width: calc(100% - 40px);
      min-height: 62px;
      gap: 18px;
    }
    .desktop-nav {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    summary {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 27px;
      height: 38px;
      cursor: pointer;
      list-style: none;
    }
    summary::-webkit-details-marker {
      display: none;
    }
    summary span {
      display: block;
      width: 18px;
      height: 1px;
      margin-inline: auto;
      background: var(--text);
    }
    .mobile-menu nav {
      position: absolute;
      top: 62px;
      left: 0;
      right: 0;
      padding: 9px 24px 19px;
      border-bottom: 1px solid var(--line);
      background: var(--bg);
      box-shadow: 0 12px 20px #00000005;
    }
    .mobile-menu nav a {
      display: flex;
      min-height: 46px;
      font-size: 15px;
    }
  }
</style>
