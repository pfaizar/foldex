---
// The page's sections as Foldex tabs. The current tab follows the scroll, and
// the strip takes the colour of the section underneath it.
import Folder from './ui/Folder.astro';
import Icon from './ui/Icon.astro';
import { navigation, site } from '../config/site';
---

<header class="site-header" data-tone="night">
  <nav class="strip" aria-label="Primary">
    <a class="tab tab--home" href="#top" data-tab="top" aria-current="true">
      <img src="/dither/folder-64.png" alt="" width="18" height="18" />
      <span>Foldex</span>
    </a>
    {navigation.map(({ label, href }) => (
      <a class="tab" href={href} data-tab={href.slice(1)}>
        <Folder />
        <span>{label}</span>
      </a>
    ))}
    <span class="new-tab" aria-hidden="true">
      +
    </span>
    {site.repository && (
      <a class="source" href={site.repository} aria-label="Foldex on GitHub">
        <Icon name="github" size={16} />
        <span>Source</span>
      </a>
    )}
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const tabs = [...header.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
  const sections = [
    ...document.querySelectorAll<HTMLElement>('[data-tone]'),
  ].filter((el) => el !== header);

  let queued = false;
  const update = () => {
    queued = false;
    const line = header.offsetHeight / 2;
    const probe = innerHeight * 0.35;
    let tone = 'night';
    let current = 'top';
    for (const section of sections) {
      const box = section.getBoundingClientRect();
      if (box.top <= line && box.bottom > line) tone = section.dataset.tone!;
      if (section.id && box.top <= probe) current = section.id;
    }
    header.dataset.tone = tone;
    for (const tab of tabs) {
      if (tab.dataset.tab === current) tab.setAttribute('aria-current', 'true');
      else tab.removeAttribute('aria-current');
    }
  };
  const queue = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(update);
  };
  addEventListener('scroll', queue, { passive: true });
  addEventListener('resize', queue);
  update();
</script>

<style>
  .site-header {
    --chrome: #15191c;
    --tab: #0b0e10;
    --tab-text: #8b969b;
    --tab-current: #f1f4f4;
    --edge: #262d31;
    position: fixed;
    z-index: 50;
    inset: 0 0 auto;
    background: var(--chrome);
    box-shadow: inset 0 -1px var(--edge);
    transition: background-color 200ms var(--ease-out);
  }
  .site-header[data-tone='paper'] {
    --chrome: #dfe3e2;
    --tab: var(--paper);
    --tab-text: #5d676b;
    --tab-current: var(--ink);
    --edge: #c9d0d0;
  }
  .site-header[data-tone='yellow'] {
    --chrome: #f0bb35;
    --tab: var(--yellow);
    --tab-text: #5e4a14;
    --tab-current: var(--ink);
    --edge: #d9a52a;
  }
  .strip {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    width: min(var(--page), 100% - var(--gutter) * 2);
    height: 44px;
    margin-inline: auto;
  }
  .tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    width: 168px;
    min-width: 0;
    height: 36px;
    padding: 0 12px;
    border-radius: 8px 8px 0 0;
    color: var(--tab-text);
    font-size: 13px;
    transition:
      color 150ms var(--ease-out),
      background-color 150ms var(--ease-out);
  }
  .tab span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tab img {
    image-rendering: pixelated;
  }
  .tab:hover {
    color: var(--tab-current);
  }
  .tab[aria-current] {
    z-index: 1;
    background: var(--tab);
    color: var(--tab-current);
    box-shadow:
      inset 1px 0 var(--edge),
      inset -1px 0 var(--edge),
      inset 0 1px var(--edge);
  }
  /* The active tab opens into the page, like the app's. */
  .tab[aria-current]::after {
    content: '';
    position: absolute;
    inset: auto 1px -1px;
    height: 1px;
    background: var(--tab);
  }
  .tab:not([aria-current]) + .tab:not([aria-current])::before {
    content: '';
    position: absolute;
    left: -1px;
    height: 16px;
    border-left: 1px solid var(--edge);
  }
  .new-tab {
    align-self: center;
    padding: 0 10px;
    color: var(--tab-text);
    font-size: 18px;
    line-height: 1;
  }
  .source {
    display: flex;
    align-items: center;
    gap: 8px;
    align-self: center;
    margin-left: auto;
    padding: 6px 10px;
    border-radius: 6px;
    color: var(--tab-text);
    font-size: 13px;
    transition: color 150ms var(--ease-out);
  }
  .source:hover {
    color: var(--tab-current);
  }
  @media (max-width: 760px) {
    .tab {
      width: auto;
      flex: 0 1 auto;
    }
    .tab:not(.tab--home):not([aria-current]) {
      display: none;
    }
    .new-tab,
    .source span {
      display: none;
    }
  }
</style>
