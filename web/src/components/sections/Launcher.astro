---
// A desktop with work in progress, and the Foldex launcher over it. Visitors
// can summon it with the real shortcut (or a click), search it, do sums and
// conversions, and switch between the windows behind it. While nobody is
// using it, it runs through a few errands on its own.
import Aura from '../Aura.astro';
import Keys from '../ui/Keys.astro';
import { favorites, recents, tries } from '../../data/launcher';

const contexts = [
  { name: 'Code', title: 'main.rs — Code', tone: 'dark' },
  { name: 'Slides', title: 'Q3 review — Slides', tone: 'light' },
  { name: 'Sheets', title: 'budget-2026.xlsx — Sheets', tone: 'light' },
  { name: 'Call', title: 'Weekly sync — Call', tone: 'dark' },
];
// Each line of the editor as [syntax class, text] pairs.
const code: [string, string][][] = [
  [
    ['k', 'fn '],
    ['f', 'main'],
    ['p', '() {'],
  ],
  [
    ['p', '    '],
    ['k', 'let mut '],
    ['v', 'app'],
    ['p', ' = Foldex::'],
    ['f', 'new'],
    ['p', '();'],
  ],
  [
    ['p', '    app.'],
    ['f', 'open_tab'],
    ['p', '('],
    ['s', '"C:/Users/you/Studio"'],
    ['p', ');'],
  ],
  [
    ['p', '    app.'],
    ['f', 'split'],
    ['p', '(Direction::Right);'],
  ],
  [['c', '    // Ctrl+Alt+Space from anywhere']],
  [
    ['p', '    app.'],
    ['f', 'launcher'],
    ['p', '().'],
    ['f', 'register'],
    ['p', '();'],
  ],
  [
    ['p', '    app.'],
    ['f', 'run'],
    ['p', '()'],
  ],
  [['p', '}']],
];
const sheet = [
  ['', 'Q1', 'Q2', 'Q3', 'Q4'],
  ['Design', '12,400', '13,100', '14,900', '15,200'],
  ['Hosting', '3,210', '3,480', '3,620', '3,900'],
  ['Hardware', '8,000', '—', '2,400', '—'],
  ['Travel', '1,150', '2,300', '980', '1,700'],
  ['Software', '4,600', '4,600', '4,750', '4,750'],
  ['Total', '29,360', '23,480', '26,650', '25,550'],
];
const people = [
  ['AK', 'Aiko'],
  ['MR', 'Mateo'],
  ['SN', 'Sana'],
  ['JB', 'Jonas'],
];
---

<section class="launcher" id="launcher" aria-labelledby="launcher-title">
  <div class="wrap head" data-reveal>
    <button
      type="button"
      class="summon"
      data-summon
      aria-label="Open the launcher (Ctrl+Alt+Space)"
    >
      <Keys keys={['Ctrl', 'Alt', 'Space']} class="giant" />
    </button>
    <h2 id="launcher-title" class="title">
      Open anything, <span class="soft">from anywhere.</span>
    </h2>
    <p>
      Apps, files, favorites, open windows, and a calculator, over whatever
      you’re doing. Press it now.
    </p>
  </div>

  <div class="wrap">
    <div class="desk" data-desk data-reveal>
      <Aura palette="dusk" seed={9} />

      <div class="contexts" aria-hidden="true">
        {contexts.map((ctx, i) => (
          <div
            class:list={['win', `win--${ctx.name.toLowerCase()}`, ctx.tone]}
            data-context={i}
            data-current={i === 0 ? '' : undefined}
          >
            <p class="bar">
              <span>{ctx.title}</span>
              <svg
                viewBox="0 0 66 10"
                width="66"
                height="10"
                aria-hidden="true"
              >
                <path d="M0 5.5h10M28 1h9v9h-9zM57 1l8 8M65 1l-8 8"></path>
              </svg>
            </p>
            {ctx.name === 'Code' && (
              <div class="code mono">
                {code.map((line, n) => (
                  <p>
                    <span class="ln">{n + 1}</span>
                    {line.map(([kind, text]) => (
                      <span class={kind}>{text}</span>
                    ))}
                  </p>
                ))}
              </div>
            )}
            {ctx.name === 'Slides' && (
              <div class="slides">
                <div class="thumbs">
                  <i></i>
                  <i class="on"></i>
                  <i></i>
                </div>
                <div class="slide">
                  <p class="kicker">Q3 review</p>
                  <p class="big">Shipping faster, together.</p>
                </div>
              </div>
            )}
            {ctx.name === 'Sheets' && (
              <table class="sheet">
                <tbody>
                  {sheet.map((row, r) => (
                    <tr>
                      {row.map((cell, c) => (
                        <td
                          class:list={{
                            label: r === 0 || c === 0,
                            pick: r === 3 && c === 3,
                          }}
                        >
                          {cell}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
            {ctx.name === 'Call' && (
              <div class="call">
                {people.map(([initials, name], n) => (
                  <div class="person" style={`--n:${n}`}>
                    <b>{initials}</b>
                    <span>{name}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>

      <div class="taskbar" aria-hidden="true">
        <div class="apps">
          <i class="start"></i>
          <i class="foldex"></i>
          {contexts.map((ctx, i) => (
            <i
              class:list={['app', ctx.name.toLowerCase()]}
              data-dock={i}
              data-current={i === 0 ? '' : undefined}
            ></i>
          ))}
        </div>
        <p class="clock mono">10:24</p>
      </div>

      <div class="scrim" data-scrim></div>

      <div
        class="panel"
        data-panel
        data-open
        role="dialog"
        aria-label="Foldex launcher demo"
      >
        <label class="search">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <circle cx="7" cy="7" r="4.5"></circle>
            <path d="m10.5 10.5 3.5 3.5"></path>
          </svg>
          <input
            type="text"
            placeholder="Search anything…"
            aria-label="Search the launcher"
            aria-controls="launcher-results"
            autocomplete="off"
            spellcheck="false"
            data-input
          />
          <kbd class="esc mono">Esc</kbd>
        </label>
        <div
          class="results"
          id="launcher-results"
          role="listbox"
          aria-label="Results"
          data-results
        >
          <p class="group">Favorites</p>
          {favorites.map((entry, i) => (
            <div
              class="row"
              role="option"
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              <i class="ic folder"></i>
              <span class="name">{entry.title}</span>
              <span class="detail">{entry.detail}</span>
            </div>
          ))}
          <p class="group">Recents</p>
          {recents.map((entry) => (
            <div class="row" role="option" aria-selected="false">
              <i class="ic file" data-mark={entry.mark}></i>
              <span class="name">{entry.title}</span>
              <span class="detail">{entry.detail}</span>
            </div>
          ))}
          <p class="group">
            Applications <span>Type to find more</span>
          </p>
        </div>
        <p class="hints mono" aria-hidden="true">
          <span>
            <kbd>↑</kbd>
            <kbd>↓</kbd> select
          </span>
          <span>
            <kbd>Enter</kbd> open
          </span>
          <span>
            <kbd>Esc</kbd> close
          </span>
        </p>
      </div>

      <p class="toast" data-toast role="status" aria-live="polite"></p>
    </div>

    <p class="tries" data-reveal>
      <span>Try</span>
      {tries.map((query) => (
        <button type="button" class="try mono" data-try={query}>
          {query}
        </button>
      ))}
    </p>
  </div>
</section>

<script>
  import { automatic } from '../../data/calculator';
  import { entries, type Entry, type Group } from '../../data/launcher';

  const desk = document.querySelector<HTMLElement>('[data-desk]')!;
  const panel = desk.querySelector<HTMLElement>('[data-panel]')!;
  const input = desk.querySelector<HTMLInputElement>('[data-input]')!;
  const list = desk.querySelector<HTMLElement>('[data-results]')!;
  const toast = desk.querySelector<HTMLElement>('[data-toast]')!;
  const scrim = desk.querySelector<HTMLElement>('[data-scrim]')!;
  const contexts = [...desk.querySelectorAll<HTMLElement>('[data-context]')];
  const docks = [...desk.querySelectorAll<HTMLElement>('[data-dock]')];
  const summon = document.querySelector<HTMLButtonElement>('[data-summon]')!;
  const caps = [...summon.querySelectorAll<HTMLElement>('.key')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  type Row =
    | Entry
    | { kind: 'calc'; title: string; detail: string; group: 'Calculator' };
  let rows: Row[] = [];
  let selected = 0;
  let open = true;
  let current = 0;

  const escape = (text: string) =>
    text.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);

  const icon = (row: Row) => {
    if (row.kind === 'calc') return '<i class="ic calc">=</i>';
    if (row.kind === 'app')
      return `<i class="ic app" style="--a:${row.tint![0]};--b:${row.tint![1]}">${escape(row.mark!)}</i>`;
    if (row.kind === 'file')
      return `<i class="ic file" data-mark="${escape(row.mark!)}"></i>`;
    return `<i class="ic ${row.kind}"></i>`;
  };

  // Prefix beats word start beats substring beats letters in order.
  const score = (title: string, query: string) => {
    const t = title.toLowerCase();
    if (t.startsWith(query)) return 4;
    if (t.split(/[\s./_—-]+/).some((word) => word.startsWith(query))) return 3;
    if (t.includes(query)) return 2;
    let at = 0;
    for (const c of t) if (c === query[at]) at++;
    return at === query.length ? 1 : 0;
  };

  const order: (Group | 'Calculator')[] = [
    'Calculator',
    'Favorites',
    'Apps',
    'Recents',
    'Files',
    'Windows',
    'Actions',
  ];
  const labels: Record<string, string> = { Apps: 'Applications' };

  const search = (text: string): Row[] => {
    const query = text.trim().toLowerCase();
    if (!query)
      return entries.filter(
        (e) => e.group === 'Favorites' || e.group === 'Recents',
      );
    const found: Row[] = [];
    const result = automatic(text);
    if (result)
      found.push({
        kind: 'calc',
        title: result,
        detail: 'Enter to copy',
        group: 'Calculator',
      });
    const matches = entries
      .map((entry) => ({ entry, s: score(entry.title, query) }))
      .filter(({ s }) => s > 0)
      .sort((a, b) => b.s - a.s);
    for (const group of order)
      for (const { entry } of matches)
        if (entry.group === group) found.push(entry);
    // Keep the best few, still shown in group order.
    const kept = new Set(
      [...found].sort((a, b) => rank(b, query) - rank(a, query)).slice(0, 7),
    );
    return found.filter((row) => kept.has(row));
  };
  const rank = (row: Row, query: string) =>
    row.kind === 'calc' ? 9 : score(row.title, query);

  const render = () => {
    rows = search(input.value);
    selected = Math.min(selected, Math.max(0, rows.length - 1));
    let html = '';
    let last = '';
    rows.forEach((row, i) => {
      if (row.group !== last) {
        last = row.group;
        html += `<p class="group">${labels[row.group] ?? row.group}</p>`;
      }
      const calc = row.kind === 'calc' ? ' is-calc' : '';
      html += `<div class="row${calc}" role="option" id="lr-${i}" aria-selected="${i === selected}" data-i="${i}">${icon(row)}<span class="name">${escape(row.title)}</span><span class="detail">${escape(row.detail)}</span></div>`;
    });
    if (!input.value.trim())
      html +=
        '<p class="group">Applications <span>Type to find more</span></p>';
    if (!rows.length)
      html += `<p class="empty">No results for “${escape(input.value)}”</p>`;
    list.innerHTML = html;
    input.setAttribute(
      'aria-activedescendant',
      rows.length ? `lr-${selected}` : '',
    );
  };

  const choose = (i: number) => {
    selected = Math.max(0, Math.min(rows.length - 1, i));
    list
      .querySelectorAll('.row')
      .forEach((row, n) =>
        row.setAttribute('aria-selected', String(n === selected)),
      );
    input.setAttribute('aria-activedescendant', `lr-${selected}`);
  };

  let toastTimer = 0;
  const say = (text: string) => {
    toast.textContent = text;
    toast.classList.add('is-on');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove('is-on'), 1800);
  };

  const focusContext = (i: number) => {
    current = i;
    contexts.forEach((ctx, n) => ctx.toggleAttribute('data-current', n === i));
    docks.forEach((dock, n) => dock.toggleAttribute('data-current', n === i));
  };

  const setOpen = (next: boolean, focus = false) => {
    open = next;
    panel.toggleAttribute('data-open', next);
    scrim.classList.toggle('is-on', next);
    if (next) {
      input.value = '';
      selected = 0;
      render();
      if (focus) input.focus({ preventScroll: true });
    } else if (document.activeElement === input) {
      summon.focus({ preventScroll: true });
    }
  };

  // What Enter does: the same outcome the real launcher has, told in a toast.
  const activate = (fromUser: boolean) => {
    const row = rows[selected];
    if (!row) return;
    setOpen(false);
    if (row.kind === 'calc') {
      if (fromUser)
        navigator.clipboard
          ?.writeText(row.title.split(' ')[0]!)
          .catch(() => {});
      say(`Copied ${row.title}`);
    } else if (row.kind === 'window') {
      focusContext(row.context!);
    } else if (row.kind === 'action') {
      say(row.title);
    } else if (row.kind === 'app') {
      say(`Opening ${row.title}`);
    } else {
      say(`Opening ${row.title} in Foldex`);
    }
  };

  const press = (down: boolean) =>
    caps.forEach((cap) => cap.classList.toggle('is-down', down));

  // Visitors take over from the demo the moment they do anything here.
  let lastInput = 0;
  let run = 0;
  const takeOver = () => {
    lastInput = Date.now();
    run++;
  };

  input.addEventListener('input', () => {
    takeOver();
    selected = 0;
    render();
  });
  input.addEventListener('keydown', (event) => {
    takeOver();
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      const step = event.key === 'ArrowDown' ? 1 : -1;
      choose((selected + step + rows.length) % rows.length);
    } else if (event.key === 'Enter') {
      event.preventDefault();
      activate(true);
    } else if (event.key === 'Escape') {
      event.preventDefault();
      setOpen(false);
    }
  });
  list.addEventListener('pointermove', (event) => {
    const row = (event.target as Element).closest<HTMLElement>('.row');
    if (row?.dataset.i) choose(Number(row.dataset.i));
  });
  list.addEventListener('click', (event) => {
    const row = (event.target as Element).closest<HTMLElement>('.row');
    if (!row?.dataset.i) return;
    takeOver();
    choose(Number(row.dataset.i));
    activate(true);
  });
  scrim.addEventListener('click', () => {
    takeOver();
    setOpen(false);
  });
  desk.addEventListener('pointerdown', takeOver);
  summon.addEventListener('click', () => {
    takeOver();
    setOpen(!open, true);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-try]').forEach((button) =>
    button.addEventListener('click', () => {
      takeOver();
      if (!open) setOpen(true);
      input.value = button.dataset.try!;
      selected = 0;
      render();
      input.focus({ preventScroll: true });
    }),
  );

  let visible = false;
  new IntersectionObserver(
    (records) => {
      visible = records.some((record) => record.isIntersecting);
      if (!visible) run++;
    },
    { threshold: 0.35 },
  ).observe(desk);

  // The real shortcut works while the desk is on screen.
  addEventListener('keydown', (event) => {
    if (!visible || !event.ctrlKey || !event.altKey || event.code !== 'Space')
      return;
    event.preventDefault();
    takeOver();
    setOpen(!open, true);
  });

  // The demo: errands over each window in turn.
  const errands: [context: number, query: string, pick: number][] = [
    [0, 'term', 0],
    [2, '1920*1080/1024', 0],
    [3, 'desi', 0],
    [1, '12 km to mi', 0],
    [0, 'launch', 0],
  ];
  const sleep = (ms: number) => new Promise((done) => setTimeout(done, ms));
  let playing = false;
  let errand = 0;
  const demo = async (id: number) => {
    const alive = () => id === run;
    playing = true;
    for (; alive(); errand++) {
      const [context, query, pick] = errands[errand % errands.length]!;
      if (context !== current) {
        focusContext(context);
        await sleep(1400);
        if (!alive()) return;
      }
      press(true);
      await sleep(260);
      press(false);
      if (!alive()) return;
      setOpen(true);
      await sleep(700);
      for (const char of query) {
        if (!alive()) return;
        input.value += char;
        selected = 0;
        render();
        await sleep(70 + Math.random() * 70);
      }
      await sleep(500);
      if (!alive()) return;
      choose(pick);
      await sleep(900);
      if (!alive()) return;
      activate(false);
      await sleep(2600);
    }
  };
  const play = async () => {
    try {
      await demo(++run);
    } finally {
      playing = false;
    }
  };
  window.setInterval(() => {
    if (playing || reduced.matches || !visible || document.hidden || open)
      return;
    if (Date.now() - lastInput < 9000) return;
    play();
  }, 1000);

  // Start closed when the demo can play; otherwise the open state stays.
  if (!reduced.matches) setOpen(false);
  else render();
</script>

<style>
  .launcher {
    padding-bottom: clamp(96px, 12vw, 160px);
  }
  .head {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .summon {
    padding: 8px;
    border: 0;
    border-radius: 20px;
    background: none;
    cursor: pointer;
  }
  .summon :global(.giant) {
    gap: 10px;
    font-size: clamp(18px, 2vw, 26px);
  }
  .summon :global(.giant .key) {
    height: 2.6em;
    padding-inline: 0.8em;
    border-radius: 12px;
    box-shadow:
      0 0 0 1px #0e10120f,
      0 1px 0 1px #0e10120a,
      0 12px 24px -12px #0e101240,
      inset 0 -3px 0 #0e10120a;
  }
  .summon:hover :global(.key) {
    transform: translateY(-1px);
  }
  .summon :global(.giant .key[data-key=' ']) {
    min-width: 6em;
  }
  .summon :global(.giant .key.is-down) {
    transform: translateY(2px);
    box-shadow: 0 0 0 1px var(--ink);
  }
  .head h2 {
    margin-top: 32px;
  }
  .head p {
    max-width: 40ch;
    margin-top: 14px;
    color: var(--muted);
  }

  /* The desk: a wallpaper, windows, a taskbar, and the launcher on top. */
  .desk {
    position: relative;
    overflow: hidden;
    height: clamp(460px, 52vw, 640px);
    margin-top: clamp(40px, 5vw, 64px);
    border-radius: 24px;
    isolation: isolate;
    box-shadow: inset 0 0 0 1px #0e10121a;
  }
  .contexts {
    position: absolute;
    inset: 0 0 52px;
  }
  .win {
    position: absolute;
    top: 9%;
    left: 50%;
    width: min(760px, 78%);
    height: 74%;
    overflow: hidden;
    border-radius: 12px;
    box-shadow:
      0 0 0 1px #ffffff1a,
      0 30px 60px -20px #000a;
    opacity: 0;
    transform: translate(-50%, 16px) scale(0.97);
    transition:
      opacity 500ms var(--ease-out),
      transform 600ms var(--ease-out);
  }
  .win[data-current] {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .win.dark {
    background: #1b1d1f;
    color: #c8ccce;
  }
  .win.light {
    background: #f7f7f5;
    color: var(--ink-2);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 34px;
    padding: 0 14px;
    font-size: 12px;
    opacity: 0.7;
  }
  .dark .bar {
    border-bottom: 1px solid #ffffff12;
  }
  .light .bar {
    border-bottom: 1px solid var(--line);
  }
  /* Windows caption buttons: minimise, maximise, close. */
  .bar svg {
    fill: none;
    stroke: currentColor;
  }

  .code {
    padding: 18px 0;
    font-size: clamp(11px, 1.15vw, 14px);
    line-height: 1.9;
    white-space: pre;
  }
  .code .ln {
    display: inline-block;
    width: 3.5em;
    padding-right: 1.4em;
    color: #5b6266;
    text-align: right;
  }
  .code .k {
    color: #c49a6c;
  }
  .code .f {
    color: #8fb3c9;
  }
  .code .s {
    color: #a7bd9a;
  }
  .code .v {
    color: #d8c7a5;
  }
  .code .c {
    color: #6c7478;
  }

  .slides {
    display: grid;
    grid-template-columns: 18% 1fr;
    gap: 16px;
    height: calc(100% - 34px);
    padding: 16px;
  }
  .thumbs {
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .thumbs i,
  .slide {
    border-radius: 6px;
    background:
      url('/grain.png') 0 0 / 120px,
      radial-gradient(80% 90% at 75% 20%, #dcb894, transparent 70%),
      linear-gradient(150deg, #5d7183, #1c2024);
    background-blend-mode: overlay, normal, normal;
  }
  .thumbs i {
    aspect-ratio: 16 / 10;
    opacity: 0.6;
  }
  .thumbs i.on {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--teal);
  }
  .slide {
    display: grid;
    align-content: end;
    padding: 6%;
    color: #fff;
  }
  .kicker {
    font-size: 12px;
    opacity: 0.7;
  }
  .big {
    max-width: 12em;
    margin-top: 6px;
    font-size: clamp(20px, 3vw, 40px);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .sheet {
    width: 100%;
    border-collapse: collapse;
    font-size: clamp(10px, 1.1vw, 13px);
  }
  .sheet td {
    height: 2.6em;
    padding: 0 12px;
