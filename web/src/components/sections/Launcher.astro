---
import LoopVideo from '../LoopVideo.astro';
import Keys from '../ui/Keys.astro';
---

<section class="launcher" data-tone="yellow" aria-labelledby="launcher-title">
  <div class="dither-edge" style="--from: var(--night)"></div>
  <div class="wrap layout">
    <div class="copy">
      <Keys keys={['Ctrl', 'Alt', 'Space']} class="giant" />
      <h2 id="launcher-title" class="pixel">
        Open anything, from anywhere.
      </h2>
      <p>
        Apps, files, favorites, and a calculator, over whatever you’re doing.
      </p>
    </div>
    <LoopVideo
      name="launcher"
      class="shot"
      keycast={false}
      label="The Foldex launcher working out 1920*1080/1024 as it is typed."
    />
  </div>
</section>

<style>
  .launcher {
    position: relative;
    overflow: hidden;
    padding-bottom: clamp(96px, 11vw, 160px);
    background: var(--yellow);
    color: var(--ink);
  }
  .layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px clamp(32px, 5vw, 80px);
    align-items: center;
    padding-top: clamp(32px, 5vw, 72px);
  }
  .copy :global(.giant) {
    gap: 8px;
    font-size: clamp(20px, 2.4vw, 32px);
  }
  .copy :global(.giant .key) {
    height: 2.4em;
    padding-inline: 0.7em;
    border-color: var(--ink);
    border-bottom-width: 5px;
    border-radius: 8px;
    background: #fff3;
  }
  .copy :global(.giant .key[data-key=' ']) {
    min-width: 6em;
  }
  .copy :global(.giant .key.is-down) {
    border-bottom-width: 2px;
    transform: translateY(3px);
    background: var(--ink);
    color: var(--yellow);
  }
  h2 {
    margin-top: 40px;
    font-size: clamp(40px, 4.6vw, 68px);
    line-height: 0.95;
  }
  p {
    max-width: 34ch;
    margin-top: 20px;
    color: #4a3b10;
    font-size: 17px;
  }
  .shot {
    justify-self: end;
    width: min(100%, 640px);
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .shot {
      justify-self: start;
    }
  }
</style>
