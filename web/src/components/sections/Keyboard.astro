---
const shortcuts = [
  { action: 'Find a file', keys: ['Ctrl', 'F'] },
  { action: 'Open a new tab', keys: ['Ctrl', 'T'] },
  { action: 'Split the view', keys: ['Ctrl', 'Shift', 'S'] },
  { action: 'Open the launcher', keys: ['Ctrl', 'Alt', 'Space'] },
];
---

<section
  class="keyboard section container"
  id="keyboard"
  aria-labelledby="keyboard-title"
>
  <div class="keyboard-copy">
    <h2 id="keyboard-title">
      Keep your hands
      <br />
      on the keyboard.
    </h2>
    <p>
      Move between files, folders, and apps with a shortcut. Change any of them
      in Options.
    </p>
  </div>
  <div class="shortcut-panel">
    <dl>
      {shortcuts.map(({ action, keys }) => (
        <div class="shortcut-row">
          <dt>{action}</dt>
          <dd>
            {keys.map((key) => (
              <kbd>{key}</kbd>
            ))}
          </dd>
        </div>
      ))}
    </dl>
    <p>Press F1 in Foldex for all shortcuts.</p>
  </div>
</section>

<style>
  .keyboard {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 100px;
  }
  .keyboard-copy > p {
    max-width: 340px;
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
  }
  dl {
    margin: 0;
  }
  .shortcut-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-height: 58px;
    border-bottom: 1px solid var(--line);
  }
  dt {
    color: #444;
    font-size: 14px;
  }
  dd {
    display: flex;
    gap: 5px;
    margin: 0;
  }
  kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 29px;
    height: 27px;
    padding-inline: 7px;
    border: 1px solid #dedede;
    border-radius: 4px;
    background: #fff;
    color: #5d5d5d;
    font:
      11px 'Inter Variable',
      sans-serif;
  }
  .shortcut-panel > p {
    margin: 18px 0 0;
    color: var(--subtle);
    font-size: 12px;
    line-height: 1.5;
  }
  @media (max-width: 850px) {
    .keyboard {
      gap: 50px;
    }
  }
  @media (max-width: 720px) {
    .keyboard {
      grid-template-columns: 1fr;
      gap: 25px;
    }
    .keyboard-copy > p {
      max-width: 420px;
    }
  }
  @media (max-width: 360px) {
    dt {
      font-size: 12px;
    }
    kbd {
      min-width: 24px;
      padding-inline: 5px;
      font-size: 10px;
    }
  }
</style>
