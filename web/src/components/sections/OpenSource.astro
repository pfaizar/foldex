---
import { site } from '../../config/site';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<section
  class="open-source"
  id="open-source"
  aria-labelledby="open-source-title"
>
  <div class="source-inner section container">
    <div class="source-copy">
      <h2 id="open-source-title">
        Free to use.
        <br />
        Open to everyone.
      </h2>
      <p>
        Foldex is written in Rust and released under AGPL-3.0-only. Use it,
        change it, or help make it better. Commercial use is allowed; shared
        versions must follow the license's source-sharing requirements.
      </p>
      <div class="source-links">
        {site.repository && (
          <a href={site.repository}>
            View the source <Icon name="arrow-up-right" size={14} />
          </a>
        )}
        <a href={site.license}>
          Read the license <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
    </div>
    <div class="get-foldex" id="get-foldex">
      <h3>Get Foldex</h3>
      <p class="get-description">
        For Windows x64. Run it from a portable folder.
      </p>
      {site.download && (
        <div class="download-action">
          <Button href={site.download}>Download Foldex</Button>
          <p>Requires the Visual C++ x64 Redistributable.</p>
        </div>
      )}
      <details
        class="build-instructions"
        data-primary={!site.download ? '' : undefined}
      >
        <summary>
          Build from source <Icon name="plus" size={16} />
        </summary>
        <div class="build-content">
          <p>
            Install <a href="https://www.rust-lang.org/tools/install">Rust</a>{' '}
            and{' '}
            <a href="https://visualstudio.microsoft.com/visual-cpp-build-tools/">
              Visual Studio C++ Build Tools
            </a>
            , then run these commands from the repository.
          </p>
          <div class="code-block">
            <pre><code>cargo build --locked --release
.\target\release\foldex.exe</code></pre>
            <button
              type="button"
              class="copy-button"
              aria-label="Copy build commands"
              data-copy-commands
            >
              <Icon name="copy" size={15} />
            </button>
          </div>
          <span
            class="copy-status sr-only"
            role="status"
            aria-live="polite"
          ></span>
          {site.repository && (
            <a
              class="build-guide"
              href={site.repository.replace(/\/$/, '') + '#installation'}
            >
              Installation guide <Icon name="arrow-up-right" size={13} />
            </a>
          )}
        </div>
      </details>
    </div>
  </div>
</section>

<script>
  const build = document.querySelector<HTMLDetailsElement>(
    '.build-instructions[data-primary]',
  );
  if (build) {
    if (window.location.hash === '#get-foldex') build.open = true;
    document.querySelectorAll('a[href="#get-foldex"]').forEach((link) =>
      link.addEventListener('click', () => {
        build.open = true;
      }),
    );
  }
  const copyButton = document.querySelector<HTMLButtonElement>(
    '[data-copy-commands]',
  );
  copyButton?.addEventListener('click', async () => {
    const code = copyButton
      .closest('.code-block')
      ?.querySelector('code')?.textContent;
    const status = document.querySelector<HTMLElement>('.copy-status');
    if (!code) return;
    try {
      await navigator.clipboard.writeText(code);
      copyButton.setAttribute('aria-label', 'Build commands copied');
      copyButton.dataset.copied = 'true';
      if (status) status.textContent = 'Build commands copied to clipboard.';
      window.setTimeout(() => {
        copyButton.setAttribute('aria-label', 'Copy build commands');
        delete copyButton.dataset.copied;
        if (status) status.textContent = '';
      }, 2500);
    } catch {
      if (status) status.textContent = 'Select and copy the commands manually.';
    }
  });
</script>

<style>
  .open-source {
    background: #f1f2f2;
  }
  .source-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    align-items: start;
  }
  .source-copy > p {
    max-width: 360px;
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }
  .source-links {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    margin-top: 22px;
  }
  .source-links a,
  .build-guide {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
  }
  .source-links a:hover,
  .build-guide:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .get-foldex {
    min-width: 0;
    padding-top: 4px;
    scroll-margin-top: 50px;
  }
  h3 {
    margin: 0;
    font-size: 22px;
    font-weight: 400;
    letter-spacing: -0.4px;
  }
  .get-description {
    margin: 14px 0 25px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }
  .download-action {
    margin-bottom: 24px;
  }
  .download-action > p {
    color: var(--subtle);
    font-size: 12px;
    line-height: 1.5;
  }
  .build-instructions {
    border-top: 1px solid #d9dcdc;
    border-bottom: 1px solid #d9dcdc;
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    min-height: 53px;
    cursor: pointer;
    list-style: none;
    font-size: 14px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] summary :global(svg) {
    transform: rotate(45deg);
  }
  .build-content {
    padding-bottom: 20px;
  }
  .build-content > p {
    margin: 0 0 17px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }
  .build-content > p a {
    color: #3b4d5a;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: #a5afb6;
  }
  .code-block {
    position: relative;
    border: 1px solid #dfe2e4;
    border-radius: 4px;
    background: #fafafa;
  }
  pre {
    overflow-x: auto;
    margin: 0;
    padding: 16px 42px 16px 15px;
    color: #3c4650;
    font-size: 12px;
    line-height: 1.8;
    scrollbar-width: thin;
  }
  code {
    font-family: 'Cascadia Code', 'SFMono-Regular', Consolas, monospace;
  }
  .copy-button {
    position: absolute;
    top: 9px;
    right: 8px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 4px;
    background: #fafafa;
    color: #6c7780;
    cursor: pointer;
  }
  .copy-button:hover {
    border-color: #c4cbd0;
    color: #333;
  }
  .copy-button[data-copied] {
    color: #286943;
  }
  .build-guide {
    margin-top: 17px;
  }
  @media (max-width: 850px) {
    .source-inner {
      gap: 50px;
    }
  }
  @media (max-width: 720px) {
    .source-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .source-copy > p {
      max-width: 420px;
    }
  }
  @media (max-width: 360px) {
    pre {
      font-size: 10px;
    }
  }
</style>
