---
import HeroField from '../HeroField.astro';
import LoopVideo from '../LoopVideo.astro';
import Plate from '../Plate.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../config/site';

const headline = 'Files, without the friction.';
const words = headline.split(' ');
const download = site.installer?.href ?? site.download;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <HeroField />
  <div class="wrap copy">
    <h1 id="hero-title">
      <span class="sr-only">{headline}</span>
      <span class="words" aria-hidden="true">
        {words.map((word, i) => (
          <span class="word" style={`--i:${i}`}>
            {word}
          </span>
        ))}
      </span>
    </h1>
    <p class="lede">
      A native file explorer for Windows, built in Rust. Tabs, split panes, and
      search that keeps up with your keyboard.
    </p>
    <div class="actions">
      {download && (
        <a class="button" href={download}>
          <Icon name="windows" size={15} />
          Download for Windows
        </a>
      )}
      {site.repository && (
        <a class="button button--quiet" href={site.repository}>
          View source
        </a>
      )}
    </div>
    <p class="meta mono">
      v{site.version}
      {site.installer && <span>{site.installer.size}</span>}
      <span>Free and open source</span>
    </p>
  </div>

  <div class="stage">
    <Plate class="wrap panel" palette="dusk" seed={1}>
      <LoopVideo
        name="palette"
        priority
        class="shot"
        label="Foldex's command palette: typing “split” opens a second pane beside the first, then “close panel” closes it again."
      />
    </Plate>
  </div>
  <div class="marquee" aria-hidden="true"></div>
  <p class="count" aria-hidden="true"></p>
</section>

<script>
  // Rubber-band selection over the headline and the icons behind it, as in a
  // file list.
  const hero = document.querySelector<HTMLElement>('.hero')!;
  const marquee = hero.querySelector<HTMLElement>('.marquee')!;
  const count = hero.querySelector<HTMLElement>('.count')!;
  const words = [...hero.querySelectorAll<HTMLElement>('.word')];
  let origin: { x: number; y: number } | null = null;
  let items: HTMLElement[] = [];

  const select = (picked: Set<HTMLElement>) => {
    for (const item of items)
      item.classList.toggle('is-selected', picked.has(item));
    count.textContent = picked.size
      ? `${picked.size} item${picked.size === 1 ? '' : 's'} selected`
      : '';
    count.classList.toggle('is-on', picked.size > 0);
  };

  hero.addEventListener('pointerdown', (event) => {
    if (event.pointerType !== 'mouse' || event.button !== 0) return;
    if ((event.target as Element).closest('a, button, figure, p')) return;
    event.preventDefault();
    origin = { x: event.clientX, y: event.clientY };
    hero.setPointerCapture(event.pointerId);
    items = [...words, ...hero.querySelectorAll<HTMLElement>('.tile')];
    select(new Set());
  });
  hero.addEventListener('pointermove', (event) => {
    if (!origin) return;
    const left = Math.min(origin.x, event.clientX);
    const top = Math.min(origin.y, event.clientY);
    const right = Math.max(origin.x, event.clientX);
    const bottom = Math.max(origin.y, event.clientY);
    const box = hero.getBoundingClientRect();
    marquee.style.cssText = `left:${left - box.left}px;top:${top - box.top}px;width:${right - left}px;height:${bottom - top}px`;
    count.style.cssText = `left:${event.clientX - box.left + 14}px;top:${event.clientY - box.top + 18}px`;
    marquee.classList.add('is-on');
    select(
      new Set(
        items.filter((item) => {
          const r = item.getBoundingClientRect();
          if (!r.width) return false;
          // Icons count by their centre, which is how they look selected.
          const x = (r.left + r.right) / 2;
          const y = (r.top + r.bottom) / 2;
          return item.classList.contains('word')
            ? r.left < right &&
                r.right > left &&
                r.top < bottom &&
                r.bottom > top
            : x > left && x < right && y > top && y < bottom;
        }),
      ),
    );
  });
  const end = () => {
    origin = null;
    marquee.classList.remove('is-on');
    count.classList.remove('is-on');
  };
  hero.addEventListener('pointerup', end);
  hero.addEventListener('pointercancel', end);
</script>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--nav) + clamp(56px, 10vh, 112px));
    overflow-x: clip;
  }
  .copy {
    position: relative;
    z-index: 2;
  }
  h1 {
    max-width: 12em;
    font-size: clamp(44px, 5.8vw, 76px);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  .words {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.24em;
  }
  .word {
    margin: -0.02em -0.06em;
    padding: 0.02em 0.06em;
    border-radius: 6px;
    transition: background-color 120ms var(--ease-out);
  }
  .word.is-selected {
    background: color-mix(in srgb, var(--teal) 18%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--teal) 60%, transparent);
  }
  .lede {
    max-width: 36ch;
    margin-top: 24px;
    color: var(--muted);
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.5;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 20px;
    color: var(--faint);
    font-size: 12px;
  }

  /* The window sits on a grainy panel, in front of the icon field. */
  .stage {
    position: relative;
    z-index: 1;
    margin-top: clamp(56px, 8vw, 88px);
  }
  .panel {
    --plate-pad: clamp(24px, 5vw, 64px) clamp(16px, 5vw, 64px) 0;
  }
  .shot {
    position: relative;
    max-width: 1000px;
    margin: 0 auto -1px;
    translate: 0 1px;
  }
  .shot :global(.loop-frame) {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }
  .shot :global(video) {
    margin-bottom: -12%;
  }

  .marquee {
    position: absolute;
    z-index: 3;
    border: 1px solid var(--teal);
    border-radius: 2px;
    background: color-mix(in srgb, var(--teal) 12%, transparent);
    opacity: 0;
    pointer-events: none;
  }
  .marquee.is-on {
    opacity: 1;
  }
  .count {
    position: absolute;
    z-index: 3;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-size: 13px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms var(--ease-out);
  }
  .count.is-on {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Words settle out of a soft blur, then the rest follows. */
    .word {
      animation: focus 900ms var(--ease-out) backwards;
      animation-delay: calc(80ms + var(--i) * 70ms);
    }
    .lede,
    .actions,
    .meta,
    .shot {
      animation: rise 900ms var(--ease-out) backwards;
      animation-delay: 380ms;
    }
    .actions {
      animation-delay: 440ms;
    }
    .meta {
      animation-delay: 500ms;
    }
    .shot {
      animation-delay: 560ms;
      animation-duration: 1200ms;
    }
    @keyframes focus {
      from {
        opacity: 0;
        filter: blur(10px);
        transform: translateY(12px);
      }
    }
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
    }
  }
</style>
