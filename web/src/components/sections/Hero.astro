---
import DownloadSplit from '../DownloadSplit.astro';
import HeroField from '../HeroField.astro';
import LoopVideo from '../LoopVideo.astro';
import Plate from '../Plate.astro';
import { site } from '../../config/site';

const headline = 'Files, without the friction.';
const words = headline.split(' ');
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <HeroField />
  <div class="wrap copy">
    <h1 id="hero-title">
      <span class="sr-only">{headline}</span>
      <span class="words" aria-hidden="true">
        {words.map((word, i) => (
          <span class="word" style={`--i:${i}`}>
            {word}
          </span>
        ))}
      </span>
    </h1>
    <p class="lede">
      A native file explorer for Windows, built in Rust. Tabs, split panes, and
      search that keeps up with your keyboard.
    </p>
    <div class="actions">
      <DownloadSplit />
      {site.repository && (
        <a class="button button--quiet" href={site.repository}>
          View source
        </a>
      )}
    </div>
  </div>

  <div class="stage">
    <Plate class="wrap panel" palette="dusk" seed={1}>
      <LoopVideo
        name="palette"
        priority
        class="shot"
        label="Foldex's command palette: typing “split” opens a second pane beside the first, then “close panel” closes it again."
      />
    </Plate>
  </div>
  <div class="marquee" aria-hidden="true"></div>
  <p class="count" aria-hidden="true"></p>
</section>

<script>
  // Selection over the headline and the drifting files, as in a file list:
  // click a file, ctrl-click to add, or drag a rubber band over several.
  // Selection is kept by key: a file and its looping copy share one.
  const hero = document.querySelector<HTMLElement>('.hero')!;
  const marquee = hero.querySelector<HTMLElement>('.marquee')!;
  const count = hero.querySelector<HTMLElement>('.count')!;
  const words = [...hero.querySelectorAll<HTMLElement>('.word')];
  let origin: { x: number; y: number } | null = null;
  let moved = false;
  let base = new Set<string>();
  let selected = new Set<string>();

  words.forEach((word, i) => (word.dataset.id = `word-${i}`));
  const all = () => [...words, ...hero.querySelectorAll<HTMLElement>('.tile')];
  const select = (picked: Set<string>) => {
    selected = picked;
    for (const item of all())
      item.classList.toggle('is-selected', picked.has(item.dataset.id!));
    count.textContent = picked.size
      ? `${picked.size} item${picked.size === 1 ? '' : 's'} selected`
      : '';
  };
  const place = (event: PointerEvent) => {
    const box = hero.getBoundingClientRect();
    count.style.left = `${event.clientX - box.left + 14}px`;
    count.style.top = `${event.clientY - box.top + 18}px`;
  };

  hero.addEventListener('pointerdown', (event) => {
    if (event.button !== 0) return;
    if ((event.target as Element).closest('a, button, details, figure, p'))
      return;
    const additive = event.ctrlKey || event.metaKey || event.shiftKey;
    base = additive ? new Set(selected) : new Set();
    origin = { x: event.clientX, y: event.clientY };
    moved = false;
    place(event);
    if (event.pointerType === 'mouse') {
      event.preventDefault();
      hero.setPointerCapture(event.pointerId);
    }
  });
  hero.addEventListener('pointermove', (event) => {
    if (!origin || event.pointerType !== 'mouse') return;
    if (
      !moved &&
      Math.hypot(event.clientX - origin.x, event.clientY - origin.y) < 4
    )
      return;
    moved = true;
    const left = Math.min(origin.x, event.clientX);
    const top = Math.min(origin.y, event.clientY);
    const right = Math.max(origin.x, event.clientX);
    const bottom = Math.max(origin.y, event.clientY);
    const box = hero.getBoundingClientRect();
    marquee.style.cssText = `left:${left - box.left}px;top:${top - box.top}px;width:${right - left}px;height:${bottom - top}px`;
    marquee.classList.add('is-on');
    place(event);
    const picked = new Set(base);
    for (const item of all()) {
      const r = item.getBoundingClientRect();
      if (!r.width) continue;
      // Files count by their centre, which is how they look selected.
      const x = (r.left + r.right) / 2;
      const y = (r.top + r.bottom) / 2;
      const hit = item.classList.contains('word')
        ? r.left < right && r.right > left && r.top < bottom && r.bottom > top
        : x > left && x < right && y > top && y < bottom;
      if (hit) picked.add(item.dataset.id!);
    }
    select(picked);
    // The count only follows the pointer while the band is being dragged.
    count.classList.toggle('is-on', picked.size > 0);
  });
  const end = (event: Event) => {
    if (!origin) return;
    if (!moved && event.type === 'pointerup') {
      // A click: select that file, toggle it with ctrl, or clear.
      // The hero holds the pointer, so ask what is under it.
      const { clientX, clientY } = event as PointerEvent;
      const tile = document
        .elementFromPoint(clientX, clientY)
        ?.closest<HTMLElement>('.tile');
      const picked = new Set(base);
      const id = tile?.dataset.id;
      if (id) {
        if (base.has(id)) picked.delete(id);
        else picked.add(id);
      }
      select(picked);
    }
    origin = null;
    marquee.classList.remove('is-on');
    count.classList.remove('is-on');
  };
  // However the drag ends, the band and the count go with it.
  addEventListener('pointerup', end);
  addEventListener('pointercancel', end);
  hero.addEventListener('lostpointercapture', end);
  addEventListener('blur', end);
</script>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--nav) + clamp(56px, 10vh, 112px));
    overflow-x: clip;
  }
  /* The copy sits over the files; only its own content takes the pointer. */
  .copy {
    position: relative;
    z-index: 2;
    pointer-events: none;
  }
  .copy > * {
    width: fit-content;
    pointer-events: auto;
  }
  h1 {
    max-width: 12em;
    font-size: clamp(44px, 5.8vw, 76px);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  .words {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.24em;
  }
  .word {
    margin: -0.02em -0.06em;
    padding: 0.02em 0.06em;
    border-radius: 6px;
    transition: background-color 120ms var(--ease-out);
  }
  .word.is-selected {
    background: color-mix(in srgb, var(--teal) 18%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--teal) 60%, transparent);
  }
  .lede {
    max-width: 36ch;
    margin-top: 24px;
    color: var(--muted);
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.5;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  /* The window sits on a grainy panel, in front of the icon field. */
  .stage {
    position: relative;
    z-index: 1;
    margin-top: clamp(56px, 8vw, 88px);
  }
  .panel {
    --plate-pad: clamp(24px, 5vw, 64px) clamp(16px, 5vw, 64px) 0;
  }
  .shot {
    position: relative;
    max-width: 1000px;
    margin: 0 auto -1px;
    translate: 0 1px;
  }
  .shot :global(.loop-frame) {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }
  .shot :global(video) {
    margin-bottom: -12%;
  }

  .marquee {
    position: absolute;
    z-index: 3;
    border: 1px solid var(--teal);
    border-radius: 2px;
    background: color-mix(in srgb, var(--teal) 12%, transparent);
    opacity: 0;
    pointer-events: none;
  }
  .marquee.is-on {
    opacity: 1;
  }
  .count {
    position: absolute;
    z-index: 3;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-size: 13px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms var(--ease-out);
  }
  .count.is-on {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Words settle out of a soft blur, then the rest follows. */
    .word {
      animation: focus 900ms var(--ease-out) backwards;
      animation-delay: calc(80ms + var(--i) * 70ms);
    }
    .lede,
    .actions,
    .shot {
      animation: rise 900ms var(--ease-out) backwards;
      animation-delay: 380ms;
    }
    .actions {
      animation-delay: 440ms;
    }
    .shot {
      animation-delay: 560ms;
      animation-duration: 1200ms;
    }
    @keyframes focus {
      from {
        opacity: 0;
        filter: blur(10px);
        transform: translateY(12px);
      }
    }
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
    }
  }
</style>
