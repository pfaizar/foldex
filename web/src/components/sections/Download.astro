---
// Getting Foldex: every download as a plain row, grouped by system and
// separated by lines. Windows is the only build so far; the others are listed
// as coming soon. The visitor's own system moves to the top.
import Icon from '../ui/Icon.astro';
import OsIcon from '../ui/OsIcon.astro';
import { platforms } from '../../data/platforms';
import { site } from '../../config/site';

const windows = platforms.find((p) => p.id === 'windows')!;
const releases = site.repository
  ? `${site.repository.replace(/\/$/, '')}/releases`
  : site.download;

interface Row {
  name: string;
  text: string;
  tags: string[];
  href?: string;
  size?: string;
}
interface Group {
  id: string;
  os: string[];
  name: string;
  needs: string;
  icon: 'windows' | 'apple' | 'linux';
  rows: Row[];
}

const groups: Group[] = [
  {
    id: 'windows',
    os: ['windows', 'windows-arm'],
    name: 'Windows',
    needs: 'Windows 10 (1809 or later) and 11',
    icon: 'windows',
    rows: [
      {
        name: 'Installer',
        text: 'Adds Foldex to the Start menu and keeps it up to date.',
        tags: ['.exe', 'x64'],
        href: windows.installer?.href,
        size: windows.installer?.size,
      },
      {
        name: 'Portable',
        text: 'No install. Runs from any folder, even a USB stick.',
        tags: ['.zip', 'x64'],
        href: windows.portable?.href,
        size: windows.portable?.size,
      },
      {
        name: 'Windows on Arm',
        text: 'For Snapdragon and other Arm PCs.',
        tags: ['arm64'],
      },
    ],
  },
  {
    id: 'macos',
    os: ['macos'],
    name: 'macOS',
    needs: 'Apple silicon and Intel Macs',
    icon: 'apple',
    rows: [
      {
        name: 'Foldex for Mac',
        text: 'One app for every Mac.',
        tags: ['.dmg'],
      },
    ],
  },
  {
    id: 'linux',
    os: ['linux'],
    name: 'Linux',
    needs: 'Most desktop distributions',
    icon: 'linux',
    rows: [
      {
        name: 'AppImage',
        text: 'One file that runs on most distributions.',
        tags: ['.AppImage', 'x64'],
      },
      {
        name: 'Debian and Ubuntu',
        text: 'A package for apt-based systems.',
        tags: ['.deb', 'x64'],
      },
    ],
  },
];
---

<section class="download" id="download" aria-labelledby="download-title">
  <div class="wrap">
    <h2 id="download-title" class="title" data-reveal>
      Get Foldex. <span class="soft">Free, and ready in a minute.</span>
    </h2>

    <div class="list" data-list data-reveal style="--d: 1">
      {groups.map((group) => (
        <section
          class="group"
          data-os={group.os.join(' ')}
          aria-labelledby={`os-${group.id}`}
        >
          <header class="os">
            <OsIcon name={group.icon} size={22} />
            <span class="os-text">
              <span class="os-name" id={`os-${group.id}`}>
                {group.name}
              </span>
              <span class="os-needs">{group.needs}</span>
            </span>
          </header>
          <ul class="rows">
            {group.rows.map((row) => {
              const body = (
                <>
                  <span class="row-text">
                    <span class="row-name">{row.name}</span>
                    <span class="row-more">{row.text}</span>
                  </span>
                  <span class="meta mono">
                    {[...row.tags, row.size].filter(Boolean).join(' · ')}
                  </span>
                </>
              );
              return (
                <li>
                  {row.href ? (
                    <a class="row" href={row.href}>
                      {body}
                      <span class="action">
                        Download
                        <Icon name="arrow-down" size={15} />
                      </span>
                    </a>
                  ) : (
                    <div class="row is-soon">
                      {body}
                      <span class="action">Coming soon</span>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>

    <div class="notes" data-reveal style="--d: 2">
      <p class="note">
        Foldex isn’t code-signed yet, so the first time it runs Windows may say{' '}
        <q>Windows protected your PC</q>. Choose <b>More info</b>, then{' '}
        <b>Run anyway</b>.
      </p>
      <p class="links">
        <a href="/changelog/">What’s new in {site.version}</a>
        {releases && <a href={releases}>All releases</a>}
        <a href="/docs/#install">Install help</a>
      </p>
    </div>
  </div>
</section>

<script>
  import { detectPlatform } from '../../lib/platform';

  // Put the visitor's own system first.
  detectPlatform().then((id) => {
    if (!id) return;
    const list = document.querySelector<HTMLElement>('[data-list]');
    const group = list?.querySelector<HTMLElement>(
      `[data-os~="${CSS.escape(id)}"]`,
    );
    if (list && group) list.prepend(group);
  });
</script>

<style>
  .download {
    padding-bottom: clamp(96px, 12vw, 160px);
  }
  h2 {
    max-width: 14em;
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  /* Systems and their rows, divided only by hairlines. */
  .list {
    border-bottom: 1px solid var(--line);
  }
  .group {
    display: grid;
    grid-template-columns: minmax(200px, 300px) 1fr;
    gap: 12px 32px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }
  .os {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding-top: 14px;
    color: var(--ink);
  }
  .os :global(svg) {
    flex-shrink: 0;
    margin-top: 1px;
  }
  .os-text {
    display: grid;
    gap: 2px;
  }
  .os-name {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .os-needs {
    color: var(--muted);
    font-size: 14px;
  }

  .rows {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rows li + li {
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 1fr auto 140px;
    align-items: center;
    gap: 8px 32px;
    padding: 16px 0;
  }
  .row-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .row-name {
    font-weight: 500;
  }
  .row-more {
    color: var(--muted);
    font-size: 14px;
  }
  .meta {
    color: var(--muted);
    font-size: 13px;
    white-space: nowrap;
  }
  .action {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
  }
  a.row .action {
    justify-self: end;
    height: 40px;
    padding: 0 16px 0 18px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    transition: background-color 150ms var(--ease-out);
  }
  a.row:hover .action {
    background: #2a2e32;
  }
  a.row:hover .row-name {
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 4px;
  }
  .is-soon .row-name {
    color: var(--ink-2);
  }
  .is-soon .meta,
  .is-soon .action {
    color: var(--faint);
    font-weight: 400;
  }

  .notes {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: 16px 40px;
    margin-top: 24px;
    color: var(--muted);
    font-size: 14px;
  }
  .note {
    max-width: 62ch;
  }
  .note b,
  q {
    color: var(--ink-2);
    font-weight: 500;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .links a {
    color: var(--ink-2);
  }
  .links a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    a.row:hover .action :global(svg) {
      animation: drop 700ms var(--ease-out);
    }
    @keyframes drop {
      45% {
        transform: translateY(6px);
        opacity: 0;
      }
      46% {
        transform: translateY(-6px);
      }
    }
  }

  @media (max-width: 860px) {
    .group {
      grid-template-columns: 1fr;
      padding: 24px 0 8px;
    }
    .os {
      padding-top: 0;
    }
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr auto;
    }
    .meta {
      grid-row: 2;
    }
    .action {
      grid-row: 1 / 3;
      grid-column: 2;
    }
    a.row .action {
      width: 44px;
      padding: 0;
      justify-content: center;
      font-size: 0;
      gap: 0;
    }
    .is-soon .action {
      font-size: 13px;
    }
  }
</style>
