---
// The release as it would look opened in Foldex: an address bar and two files.
import Icon from '../ui/Icon.astro';
import Keys from '../ui/Keys.astro';
import { site } from '../../config/site';

const files = [
  site.installer && {
    name: `Foldex-${site.version}-windows-x64-setup.exe`,
    kind: 'Installer',
    note: 'Updates itself, no admin rights',
    icon: '/dither/folder-64.png',
    ...site.installer,
  },
  site.portable && {
    name: `Foldex-${site.version}-windows-x64-portable.zip`,
    kind: 'Portable',
    note: 'Runs from any folder or USB drive',
    icon: undefined,
    ...site.portable,
  },
].filter((file) => !!file);
const build = 'cargo build --locked --release';
---

<section
  class="download"
  id="download"
  data-tone="paper"
  aria-labelledby="download-title"
>
  <div class="dither-edge" style="--from: var(--yellow)"></div>
  <div class="wrap layout">
    <h2 id="download-title" class="pixel">
      Get Foldex.
    </h2>

    <div class="window">
      <p class="address mono" aria-hidden="true">
        <span>C:</span>
        <Icon name="chevron-right" size={12} />
        <span>Releases</span>
        <Icon name="chevron-right" size={12} />
        <span>v{site.version}</span>
      </p>
      <ul class="files" aria-label={`Foldex ${site.version} downloads`}>
        {files.map((file) => (
          <li>
            <a class="file" href={file.href}>
              {file.icon ? (
                <img
                  src={file.icon}
                  alt=""
                  width="20"
                  height="20"
                  class="pix"
                />
              ) : (
                <Icon name="package" size={20} />
              )}
              <span class="name">
                <span class="mono">{file.name}</span>
                <span class="note">{file.note}</span>
              </span>
              <span class="kind">{file.kind}</span>
              <span class="size mono">{file.size}</span>
              <span class="get">
                <Icon name="download" size={16} />
                <span class="sr-only">Download {file.kind.toLowerCase()}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="status mono" aria-hidden="true">
        {files.length} items
        <span>Windows 10 (1809+) and 11, x64</span>
      </p>
    </div>

    <div class="aside">
      <div class="build">
        <code class="mono">{build}</code>
        <button
          type="button"
          class="copy"
          data-copy={build}
          aria-label="Copy the build command"
        >
          <Icon name="copy" size={15} />
        </button>
        <span
          class="sr-only"
          role="status"
          aria-live="polite"
          data-copy-status
        ></span>
      </div>
      <p class="links">
        {site.repository && <a href={site.repository}>Source on GitHub</a>}
        <a href={site.license}>AGPL-3.0 license</a>
        {site.download && <a href={site.download}>All releases</a>}
      </p>
      <p class="fine">
        Builds aren’t code-signed yet, so SmartScreen may ask before the first
        run.
      </p>
      <p class="press">
        Already installed? <Keys keys={['Win', 'E']} /> can open Foldex instead
        of File Explorer.
      </p>
    </div>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  button?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.copy!);
      button.classList.add('is-done');
      status!.textContent = 'Copied.';
      window.setTimeout(() => {
        button.classList.remove('is-done');
        status!.textContent = '';
      }, 1800);
    } catch {
      status!.textContent = 'Select the command to copy it.';
    }
  });
</script>

<style>
  .download {
    padding-bottom: clamp(80px, 9vw, 128px);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 40px clamp(32px, 5vw, 80px);
    align-items: start;
    padding-top: clamp(32px, 5vw, 72px);
  }
  h2 {
    grid-column: 1 / -1;
    font-size: clamp(56px, 8vw, 128px);
    line-height: 0.9;
  }

  .window {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #f7f8f8;
    box-shadow: 0 24px 48px -32px #10131540;
  }
  .address {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--paper-2);
    color: var(--ink-2);
    font-size: 12px;
  }
  .address :global(svg) {
    color: var(--muted);
  }
  .files {
    margin: 0;
    padding: 6px;
    list-style: none;
  }
  .file {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) auto auto 36px;
    align-items: center;
    gap: 16px;
    padding: 12px 10px;
    border-radius: 6px;
    transition: background-color 120ms var(--ease-out);
  }
  .file:hover {
    background: color-mix(in srgb, var(--teal) 12%, transparent);
  }
  .file:active {
    background: color-mix(in srgb, var(--teal) 22%, transparent);
  }
  .pix {
    image-rendering: pixelated;
  }
  .file > :global(svg) {
    color: var(--ink-2);
  }
  .name {
    display: grid;
    min-width: 0;
  }
  .name .mono {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 14px;
  }
  .note {
    color: var(--muted);
    font-size: 13px;
  }
  .kind,
  .size {
    color: var(--muted);
    font-size: 13px;
  }
  .get {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: var(--yellow);
    color: var(--ink);
    box-shadow: inset 0 -2px var(--folder-back);
  }
  .status {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 16px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 11px;
  }

  .aside {
    display: grid;
    gap: 20px;
    font-size: 14px;
  }
  .build {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 6px 6px 14px;
    border-radius: var(--radius);
    background: var(--night);
    color: var(--night-text);
  }
  .build code {
    flex: 1;
    overflow-x: auto;
    font-size: 13px;
    white-space: nowrap;
  }
  .build code::before {
    content: '> ';
    color: var(--teal);
  }
  .copy {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 6px;
    background: #ffffff12;
    cursor: pointer;
  }
  .copy.is-done {
    background: var(--teal);
    color: #fff;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .links a {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 4px;
    transition: text-decoration-color 150ms var(--ease-out);
  }
  .links a:hover {
    text-decoration-color: currentColor;
  }
  .fine,
  .press {
    color: var(--muted);
    font-size: 13px;
  }
  .press :global(.key) {
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .file {
      grid-template-columns: 20px minmax(0, 1fr) 36px;
    }
    .kind,
    .size {
      display: none;
    }
    .status span {
      display: none;
    }
  }
</style>
