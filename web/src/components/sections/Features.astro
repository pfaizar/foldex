---
import LoopVideo from '../LoopVideo.astro';
import Plate from '../Plate.astro';
import ShortcutBoard from '../ShortcutBoard.astro';
import Keys from '../ui/Keys.astro';
import { shortcuts } from '../../data/shortcuts';
---

<section class="features" id="features" aria-labelledby="features-title">
  <div class="wrap collage">
    <h2 id="features-title" class="title" data-reveal>
      Hands stay on the keys.{' '}
      <span class="soft">Every move is a shortcut away.</span>
    </h2>

    <figure class="fig fig--search" data-reveal>
      <Plate palette="slate" seed={3}>
        <LoopVideo
          name="search"
          label="Typing “png” filters the folder in Foldex; Ctrl+E widens the search to every subfolder."
        />
      </Plate>
      <figcaption>
        <span class="what">Find anything</span>
        <span class="keys">
          <Keys keys={['Ctrl', 'F']} />
          <Keys keys={['Ctrl', 'E']} />
        </span>
      </figcaption>
    </figure>

    <figure class="fig fig--nav" data-reveal style="--d: 1">
      <Plate palette="clay" seed={5}>
        <LoopVideo
          name="navigate"
          label="Moving through folders in Foldex with the arrow keys and Enter, then back up with Alt and the up arrow."
        />
      </Plate>
      <figcaption>
        <span class="what">Walk the tree</span>
        <span class="keys">
          <Keys keys={['↓']} />
          <Keys keys={['Enter']} />
          <Keys keys={['Alt', '↑']} />
        </span>
      </figcaption>
    </figure>

    <ShortcutBoard class="fig fig--board" data-reveal>
      <figcaption>
        <span class="what">
          {shortcuts.length} shortcuts, all yours to rebind
        </span>
      </figcaption>
    </ShortcutBoard>
  </div>
</section>

<style>
  .features {
    padding-bottom: clamp(96px, 12vw, 160px);
  }
  .collage {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(48px, 6vw, 80px) clamp(20px, 3vw, 32px);
    align-items: start;
  }
  h2 {
    grid-column: 1 / 7;
    grid-row: 1;
  }
  .fig {
    margin: 0;
  }
  .fig--nav {
    grid-column: 6 / 13;
    grid-row: 1 / 3;
    margin-top: clamp(24px, 5vw, 80px);
  }
  .fig--search {
    grid-column: 1 / 6;
    grid-row: 2 / 4;
  }
  .fig--board {
    grid-column: 6 / 13;
    grid-row: 3;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 16px;
    padding-inline: 4px;
    font-size: 15px;
  }
  .what {
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (max-width: 900px) {
    .collage {
      grid-template-columns: minmax(0, 1fr);
    }
    h2,
    .fig--nav,
    .fig--search,
    .fig--board {
      grid-column: 1;
      grid-row: auto;
      margin-top: 0;
    }
  }
</style>
