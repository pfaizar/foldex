---
import LoopVideo from '../LoopVideo.astro';
import ShortcutBoard from '../ShortcutBoard.astro';
import Keys from '../ui/Keys.astro';
import { shortcuts } from '../../data/shortcuts';
---

<section
  class="features"
  id="features"
  data-tone="paper"
  aria-labelledby="features-title"
>
  <div class="wrap collage">
    <h2 id="features-title" class="pixel">
      Hands stay on the keys.
    </h2>

    <LoopVideo
      name="search"
      class="fig fig--search"
      label="Typing “png” filters the folder in Foldex; Ctrl+E widens the search to every subfolder."
    >
      <figcaption>
        <span class="no mono">fig. 01</span>
        <span class="what">Find anything</span>
        <Keys keys={['Ctrl', 'F']} />
        <Keys keys={['Ctrl', 'E']} />
      </figcaption>
    </LoopVideo>

    <LoopVideo
      name="navigate"
      class="fig fig--nav"
      label="Moving through folders in Foldex with the arrow keys and Enter, then back up with Alt and the up arrow."
    >
      <figcaption>
        <span class="no mono">fig. 02</span>
        <span class="what">Walk the tree</span>
        <Keys keys={['↓']} />
        <Keys keys={['Enter']} />
        <Keys keys={['Alt', '↑']} />
      </figcaption>
    </LoopVideo>

    <ShortcutBoard class="fig fig--board">
      <figcaption>
        <span class="no mono">fig. 03</span>
        <span class="what">
          {shortcuts.length} shortcuts, all yours to rebind
        </span>
      </figcaption>
    </ShortcutBoard>
  </div>
</section>

<style>
  .features {
    padding-bottom: clamp(96px, 12vw, 176px);
  }
  .collage {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(40px, 5vw, 72px) clamp(20px, 3vw, 40px);
    align-items: start;
  }
  h2 {
    grid-column: 1 / 6;
    grid-row: 1;
    font-size: clamp(40px, 4.6vw, 68px);
    line-height: 0.95;
  }
  .fig--nav {
    grid-column: 6 / 13;
    grid-row: 1 / 3;
    margin-top: clamp(24px, 4vw, 64px);
  }
  .fig--search {
    grid-column: 1 / 6;
    grid-row: 2 / 4;
  }
  .fig--board {
    grid-column: 6 / 13;
    grid-row: 3;
    margin-top: clamp(24px, 3vw, 48px);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    margin-top: 16px;
    font-size: 15px;
  }
  .no {
    color: var(--muted);
    font-size: 12px;
  }
  .what {
    margin-right: 6px;
    font-weight: 500;
  }
  figcaption :global(.key) {
    color: var(--ink-2);
  }
  @media (max-width: 900px) {
    .collage {
      grid-template-columns: minmax(0, 1fr);
    }
    h2,
    .fig--nav,
    .fig--search,
    .fig--board {
      grid-column: 1;
      grid-row: auto;
      margin-top: 0;
    }
    .fig--search {
      width: min(100%, 420px);
    }
  }
</style>
