---
import Folder from '../ui/Folder.astro';
import { benchmarkInfo, benchmarks } from '../../data/benchmarks';

const rows = benchmarks.map((benchmark) => {
  const [foldex, explorer] = benchmark.results;
  const ratio = explorer!.value / foldex!.value;
  return {
    ...benchmark,
    foldex: `${foldex!.value} ${benchmark.unit}`,
    explorer: `${explorer!.value} ${benchmark.unit}`,
    share: foldex!.value / explorer!.value,
    times: ratio < 10 ? ratio.toFixed(1) : Math.round(ratio).toString(),
  };
});
const first = rows[0]!;
---

<section class="benchmarks" id="benchmarks" aria-labelledby="benchmarks-title">
  <div class="wrap layout">
    <div class="head" data-reveal>
      <h2 id="benchmarks-title" class="title">
        Keeps up with you. <span class="soft">Not the other way round.</span>
      </h2>
      {benchmarkInfo.placeholder && (
        <p class="sample">
          <i></i>Sample data, measured results coming soon
        </p>
      )}
    </div>

    <div class="listing" data-reveal>
      <table data-bench-table>
        <caption class="sr-only">
          Foldex compared with File Explorer. Lower is better.
        </caption>
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Foldex</th>
            <th scope="col">File Explorer</th>
            <th scope="col">
              <span class="sr-only">Difference</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row, i) => (
            <tr
              data-selected={i === 0 ? '' : undefined}
              data-times={row.times}
              data-claim={row.claim}
              data-share={row.share}
              data-foldex={row.foldex}
              data-explorer={row.explorer}
              data-detail={row.detail}
            >
              <th scope="row">
                <button type="button" aria-pressed={i === 0}>
                  <Folder />
                  {row.title}
                </button>
              </th>
              <td class="mono">{row.foldex}</td>
              <td class="mono">{row.explorer}</td>
              <td class="mono times">{row.times}×</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="method mono">{benchmarkInfo.method}</p>
    </div>

    <div
      class="readout"
      data-readout
      aria-live="polite"
      data-reveal
      style="--d: 1"
    >
      <p class="figure">
        <span data-times>{first.times}</span>
        <span class="x">×</span>
      </p>
      <p class="claim" data-claim>
        {first.claim}
      </p>
      <div class="race" style={`--share:${first.share}`}>
        <div class="lane lane--foldex">
          <span>Foldex</span>
          <span class="mono" data-foldex>
            {first.foldex}
          </span>
          <i class="bar"></i>
        </div>
        <div class="lane lane--explorer">
          <span>File Explorer</span>
          <span class="mono" data-explorer>
            {first.explorer}
          </span>
          <i class="bar"></i>
        </div>
      </div>
      <p class="detail mono" data-detail>
        {first.detail}
      </p>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('.benchmarks')!;
  const rows = [...section.querySelectorAll<HTMLTableRowElement>('tbody tr')];
  const readout = section.querySelector<HTMLElement>('[data-readout]')!;
  const race = readout.querySelector<HTMLElement>('.race')!;
  race.classList.add('is-armed');
  const field = (name: string) =>
    readout.querySelector<HTMLElement>(`[data-${name}]`)!;

  // Both bars start together; each finishes in time proportional to its value.
  const run = () => {
    race.classList.remove('is-running');
    void race.offsetWidth;
    race.classList.add('is-running');
  };

  const choose = (row: HTMLTableRowElement, focus = false) => {
    rows.forEach((other) => {
      const on = other === row;
      other.toggleAttribute('data-selected', on);
      other.querySelector('button')!.setAttribute('aria-pressed', String(on));
    });
    for (const name of ['times', 'claim', 'foldex', 'explorer', 'detail'])
      field(name).textContent = row.dataset[name]!;
    race.style.setProperty('--share', row.dataset.share!);
    readout.classList.remove('is-new');
    void readout.offsetWidth;
    readout.classList.add('is-new');
    run();
    if (focus) row.querySelector('button')!.focus();
  };

  rows.forEach((row, i) => {
    const button = row.querySelector('button')!;
    button.addEventListener('click', () => choose(row));
    button.addEventListener('keydown', (event) => {
      const step = { ArrowDown: 1, ArrowUp: -1 }[event.key];
      if (!step) return;
      event.preventDefault();
      choose(rows[(i + step + rows.length) % rows.length]!, true);
    });
  });

  new IntersectionObserver(
    (entries, observer) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      run();
      observer.disconnect();
    },
    { threshold: 0.4 },
  ).observe(race);
</script>

<style>
  .benchmarks {
    padding: clamp(96px, 12vw, 160px) 0;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 56px clamp(40px, 6vw, 96px);
  }
  .head {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px 40px;
  }
  h2 {
    max-width: 15em;
  }
  .sample {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--muted);
    font-size: 13px;
  }
  .sample i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--yellow) 30%, transparent);
  }

  /* The table is drawn as a Foldex details view. */
  .listing {
    align-self: start;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  thead th {
    height: 36px;
    padding: 0 14px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
    font-size: 13px;
    font-weight: 400;
    text-align: right;
  }
  thead th:first-child {
    text-align: left;
  }
  tbody tr {
    position: relative;
    transition: background-color 150ms var(--ease-out);
  }
  tbody tr + tr {
    box-shadow: inset 0 1px var(--line);
  }
  tbody tr:hover {
    background: #0e101205;
  }
  tbody tr[data-selected] {
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line),
      0 8px 24px -16px #0e101240;
  }
  tbody tr[data-selected] + tr {
    box-shadow: none;
  }
  tbody th,
  td {
    height: 56px;
    padding: 0 14px;
    font-weight: 400;
    text-align: right;
    white-space: nowrap;
  }
  tbody th {
    text-align: left;
  }
  tbody th:first-child {
    border-radius: 12px 0 0 12px;
  }
  td:last-child {
    border-radius: 0 12px 12px 0;
  }
  td {
    color: var(--muted);
    font-size: 13px;
  }
  td.times {
    color: var(--ink);
  }
  tbody button {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
  }
  /* The whole row is the button's hit area. */
  tbody button::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  tbody button:focus-visible {
    outline: none;
  }
  tbody tr:has(button:focus-visible) {
    outline: 2px solid var(--teal);
    outline-offset: -2px;
    border-radius: 12px;
  }
  .method {
    margin-top: 20px;
    padding-left: 14px;
    color: var(--faint);
    font-size: 12px;
  }

  .readout {
    align-self: start;
  }
  .figure {
    display: flex;
    align-items: baseline;
    font-size: clamp(96px, 12vw, 176px);
    font-weight: 380;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.06em;
    line-height: 0.85;
  }
  .x {
    margin-left: 0.04em;
    color: var(--faint);
    font-size: 0.45em;
    font-weight: 300;
  }
  .is-new .figure,
  .is-new .claim {
    animation: settle 600ms var(--ease-out);
  }
  @keyframes settle {
    from {
      opacity: 0;
      filter: blur(6px);
    }
  }
  .claim {
    margin-top: 16px;
    color: var(--ink-2);
    font-size: 20px;
    letter-spacing: -0.01em;
  }
  .race {
    display: grid;
    gap: 18px;
    margin-top: 40px;
  }
  .lane {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px 12px;
    font-size: 14px;
  }
  .lane .mono {
    color: var(--muted);
    font-size: 13px;
  }
  .bar {
    grid-column: 1 / -1;
    height: 8px;
    border-radius: 999px;
    transform-origin: left;
  }
  .lane--foldex .bar {
    width: calc(var(--share) * 100%);
    min-width: 8px;
    background: linear-gradient(90deg, var(--teal), #55c3ec);
  }
  .lane--explorer .bar {
    width: 100%;
    background: var(--line-2);
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Bars start empty only once the script is there to fill them. */
    .race.is-armed .bar {
      transform: scaleX(0);
    }
    .race.is-running .bar {
      animation: fill linear forwards;
    }
    .race.is-running .lane--explorer .bar {
      animation-duration: 1.6s;
    }
    .race.is-running .lane--foldex .bar {
      animation-duration: max(0.12s, calc(var(--share) * 1.6s));
    }
    @keyframes fill {
      to {
        transform: none;
      }
    }
  }
  .detail {
    margin-top: 24px;
    color: var(--faint);
    font-size: 12px;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .listing {
      order: 1;
    }
    tbody th,
    td,
    thead th {
      padding: 0 10px;
    }
    tbody button :global(.folder) {
      display: none;
    }
  }
</style>
