---
import BenchmarkRace from '../BenchmarkRace';
import Plate from '../Plate.astro';
import { benchmarkInfo, benchmarks } from '../../data/benchmarks';

const value = (n: number, unit: string) =>
  `${n.toLocaleString('en-US')} ${unit}`;
---

<section class="benchmarks" id="benchmarks" aria-labelledby="benchmarks-title">
  <div class="wrap">
    <div class="head" data-reveal>
      <h2 id="benchmarks-title" class="title">
        Keeps up with you. <span class="soft">Not the other way round.</span>
      </h2>
    </div>

    <Plate class="stage" palette="sand" seed={7} data-reveal style="--d: 1">
      <BenchmarkRace client:visible benchmarks={benchmarks} />
    </Plate>

    <div class="sr-only">
      <table>
        <caption>Foldex compared with File Explorer. Lower is better.</caption>
        <thead>
          <tr>
            <th scope="col">Test</th>
            <th scope="col">Foldex</th>
            <th scope="col">File Explorer</th>
          </tr>
        </thead>
        <tbody>
          {benchmarks.map((b) => (
            <tr>
              <th scope="row">{b.title}</th>
              <td>{value(b.results[0]!.value, b.unit)}</td>
              <td>{value(b.results[1]!.value, b.unit)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="method mono">{benchmarkInfo.method}</p>
  </div>
</section>

<style>
  .benchmarks {
    padding-block: clamp(96px, 12vw, 160px) clamp(56px, 7vw, 96px);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px 32px;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .head h2 {
    max-width: 15em;
  }
  .stage {
    --plate-pad: clamp(12px, 3vw, 36px);
  }
  .method {
    margin-top: 16px;
    color: var(--faint);
    font-size: 12px;
  }

  /* The race island. */
  .stage :global(.race) {
    display: grid;
    gap: 12px;
  }
  .stage :global(.tests) {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .stage :global(.test) {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 14px 16px 16px;
    overflow: hidden;
    border: 0;
    border-radius: 14px;
    background: #ffffff8c;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow: inset 0 0 0 1px #0e10120f;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition:
      background-color 300ms var(--ease-out),
      box-shadow 300ms var(--ease-out);
  }
  .stage :global(.test:hover) {
    background: #ffffffc4;
  }
  .stage :global(.test[aria-pressed='true']) {
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px #0e101214,
      0 10px 30px -18px #0e101266;
  }
  .stage :global(.test-title) {
    color: var(--muted);
    font-size: 13px;
  }
  .stage :global(.test-times) {
    display: flex;
    align-items: baseline;
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 380;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .stage :global(.x) {
    color: var(--faint);
    font-weight: 300;
  }
  /* Time left on the current test, before the race moves on. */
  .stage :global(.test-timer) {
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--teal);
    transform-origin: left;
    animation: bench-timer linear both;
  }
  @keyframes bench-timer {
    from {
      transform: scaleX(0);
    }
  }

  .stage :global(.board) {
    display: grid;
    grid-template-columns: minmax(260px, 340px) 1fr;
    gap: clamp(20px, 3vw, 40px);
    padding: clamp(20px, 3vw, 36px);
    border-radius: 16px;
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px #0e101214,
      0 24px 60px -36px #0e101273;
  }
  .stage :global(.summary) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .stage :global(.figure) {
    display: flex;
    align-items: baseline;
    font-size: clamp(64px, 8vw, 112px);
    font-weight: 360;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }
  .stage :global(.claim) {
    margin-top: 12px;
    color: var(--ink-2);
    font-size: 19px;
  }
  .stage :global(.detail) {
    margin-top: 4px;
    color: var(--faint);
    font: 12px/1.5 var(--font-mono);
  }
  .stage :global(.lanes) {
    display: grid;
    gap: 18px;
    width: 100%;
    margin-top: auto;
    padding-top: 32px;
  }
  .stage :global(.lane) {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 2px 12px;
  }
  .stage :global(.lane-name) {
    font-size: 15px;
  }
  .stage :global(.lane-status) {
    grid-row: 2;
    color: var(--muted);
    font-size: 12px;
  }
  .stage :global(.lane-value) {
    grid-row: span 2;
    font: 500 20px/1 var(--font-mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .stage :global(.unit) {
    margin-left: 4px;
    color: var(--faint);
    font-size: 12px;
  }
  .stage :global(.lane-track) {
    display: block;
    grid-column: 1 / -1;
    height: 6px;
    margin-top: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--surface-2);
  }
  .stage :global(.lane-track i) {
    display: block;
    height: 100%;
    border-radius: inherit;
    transform-origin: left;
  }
  .stage :global(.lane--foldex .lane-track i) {
    background: linear-gradient(90deg, #0a6e8e, var(--teal));
  }
  .stage :global(.lane--explorer .lane-track i) {
    background: repeating-linear-gradient(
      -45deg,
      #a1a6a9 0 3px,
      #c9cccd 3px 6px
    );
  }
  .stage :global(.replay) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    padding: 6px 12px 6px 10px;
    border: 0;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--ink-2);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .stage :global(.replay:hover) {
    background: var(--line);
  }
  .stage :global(.replay svg) {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stage :global(.chart) {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
  }
  .stage :global(.chart figcaption) {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    color: var(--muted);
    font-size: 13px;
  }
  .stage :global(.chart figcaption span) {
    padding: 1px 6px;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--faint);
    font: 11px/1.5 var(--font-mono);
  }
  .stage :global(.chart-plot) {
    flex: none;
    height: clamp(240px, 26vw, 340px);
    aspect-ratio: auto;
    font-family: var(--font-mono);
  }
  .stage :global(.plot) {
    position: relative;
  }
  .stage :global(.recharts-tooltip-wrapper) {
    z-index: 2;
  }
  /* A curtain over the plot area (inside the axes) that slides off with the
     race, drawing the curves without redrawing the chart. */
  .stage :global(.scan) {
    position: absolute;
    inset: 8px 36px 30px 34px;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    visibility: hidden;
  }
  .stage :global(.scan.is-racing) {
    visibility: visible;
    animation: bench-scan-out 300ms var(--ease-out) var(--race) forwards;
  }
  .stage :global(.scan i) {
    position: absolute;
    inset: 0;
    background: var(--surface);
    transform: translateX(calc(var(--to) * 100%));
  }
  .stage :global(.scan.is-racing i) {
    animation: bench-scan var(--race) linear both;
  }
  /* The leading edge. */
  .stage :global(.scan i::before) {
    content: '';
    position: absolute;
    inset: 0 auto 0 -1px;
    width: 2px;
    background: linear-gradient(transparent, var(--teal) 30%, var(--teal));
    box-shadow: 0 0 12px var(--teal);
  }
  @keyframes bench-scan {
    from {
      transform: translateX(0);
    }
  }
  @keyframes bench-scan-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  @media (max-width: 860px) {
    .stage :global(.tests) {
      grid-template-columns: repeat(2, 1fr);
    }
    .stage :global(.board) {
      grid-template-columns: 1fr;
    }
    .stage :global(.lanes) {
      padding-top: 24px;
    }
  }
</style>
