---
// A slow, ordered-dither noise field in the app's palette. Each 4px cell is one
// canvas pixel, scaled up without smoothing. The static image is the same field
// rendered offline (scripts/dither.py) and shows until, or instead of, WebGL.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['dither-field', className]} aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  const vertex = `
    attribute vec2 p;
    void main() { gl_Position = vec4(p, 0.0, 1.0); }
  `;
  const fragment = `
    precision mediump float;
    uniform vec2 size;
    uniform float time;
    uniform vec3 pointer;

    float hash(vec2 p) {
      return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
    }
    float noise(vec2 p) {
      vec2 i = floor(p);
      vec2 f = fract(p);
      f = f * f * (3.0 - 2.0 * f);
      return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x),
                 mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
    }
    float bayer2(vec2 a) {
      a = floor(a);
      return fract(dot(a, vec2(0.5, a.y * 0.75)));
    }
    float bayer4(vec2 a) { return bayer2(0.5 * a) * 0.25 + bayer2(a); }
    float bayer8(vec2 a) { return bayer4(0.5 * a) * 0.25 + bayer2(a); }

    void main() {
      vec2 cell = gl_FragCoord.xy;
      vec2 uv = cell / size;
      uv.y = 1.0 - uv.y;
      float aspect = size.x / size.y;
      vec2 q = vec2(uv.x * aspect, uv.y);

      float v = 0.6 * noise(q * 4.0 + vec2(time * 0.05, time * 0.02))
              + 0.4 * noise(q * 10.0 - vec2(time * 0.03, time * 0.06));
      // Calm where the headline sits: the left on wide screens, the top on tall.
      bool tall = aspect < 1.0;
      v *= clamp(tall ? 1.4 * uv.y - 0.35 : 0.15 + 1.1 * uv.x, 0.0, 1.0);
      vec2 hot = tall ? vec2(0.7, 0.92) : vec2(0.75, 0.55);
      v *= clamp(1.3 - 1.4 * length(vec2(uv.x - hot.x, (uv.y - hot.y) * 1.2)), 0.0, 1.0);

      vec2 d = (uv - pointer.xy) * vec2(aspect, 1.0);
      v += pointer.z * 0.45 * exp(-dot(d, d) * 40.0);

      float t = bayer8(cell);
      float level = clamp(floor(clamp(v, 0.0, 0.999) * 3.2 + t), 0.0, 3.0);

      vec3 color = vec3(0.043, 0.055, 0.063);
      color = mix(color, vec3(0.051, 0.227, 0.282), step(1.0, level));
      color = mix(color, vec3(0.090, 0.631, 0.800), step(2.0, level));
      color = mix(color, vec3(1.0, 0.804, 0.310), step(3.0, level));
      gl_FragColor = vec4(color, 1.0);
    }
  `;

  const CELL = 4;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('.dither-field').forEach((root) => {
    const canvas = root.querySelector('canvas')!;
    const gl = canvas.getContext('webgl', { antialias: false, alpha: false });
    if (!gl) return;

    const compile = (type: number, source: string) => {
      const shader = gl.createShader(type)!;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      return shader;
    };
    const program = gl.createProgram()!;
    gl.attachShader(program, compile(gl.VERTEX_SHADER, vertex));
    gl.attachShader(program, compile(gl.FRAGMENT_SHADER, fragment));
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;
    gl.useProgram(program);

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]),
      gl.STATIC_DRAW,
    );
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
    const uSize = gl.getUniformLocation(program, 'size');
    const uTime = gl.getUniformLocation(program, 'time');
    const uPointer = gl.getUniformLocation(program, 'pointer');

    // The pointer eases toward its target so the bump trails the cursor.
    const pointer = { x: 0.75, y: 0.5, z: 0, tx: 0.75, ty: 0.5, tz: 0 };
    let start = performance.now() - 20_000;
    let frame = 0;
    let visible = false;

    const resize = () => {
      const w = Math.max(1, Math.ceil(root.clientWidth / CELL));
      const h = Math.max(1, Math.ceil(root.clientHeight / CELL));
      if (canvas.width === w && canvas.height === h) return;
      canvas.width = w;
      canvas.height = h;
      gl.viewport(0, 0, w, h);
      gl.uniform2f(uSize, w, h);
    };
    const draw = (now: number) => {
      pointer.x += (pointer.tx - pointer.x) * 0.08;
      pointer.y += (pointer.ty - pointer.y) * 0.08;
      pointer.z += (pointer.tz - pointer.z) * 0.05;
      gl.uniform1f(uTime, (now - start) / 1000);
      gl.uniform3f(uPointer, pointer.x, pointer.y, pointer.z);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };
    const loop = (now: number) => {
      draw(now);
      frame = requestAnimationFrame(loop);
    };
    const sync = () => {
      cancelAnimationFrame(frame);
      resize();
      if (reduced.matches || !visible || document.hidden) draw(start + 20_000);
      else frame = requestAnimationFrame(loop);
    };

    new ResizeObserver(sync).observe(root);
    new IntersectionObserver((entries) => {
      visible = entries.some((entry) => entry.isIntersecting);
      sync();
    }).observe(root);
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);

    const host = root.parentElement!;
    host.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      const box = root.getBoundingClientRect();
      pointer.tx = (event.clientX - box.left) / box.width;
      pointer.ty = (event.clientY - box.top) / box.height;
      pointer.tz = 1;
    });
    host.addEventListener('pointerleave', () => (pointer.tz = 0));

    sync();
    root.classList.add('is-live');
    start = performance.now() - 20_000;
  });
</script>

<style>
  .dither-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--night) url('/dither/hero.png') center / cover;
    image-rendering: pixelated;
  }
  canvas {
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    opacity: 0;
  }
  .is-live canvas {
    opacity: 1;
  }
</style>
