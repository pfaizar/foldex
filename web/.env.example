# Optional overrides for the public repository and release links.
# Only public URLs belong in PUBLIC_ variables; they are included in the build.
PUBLIC_REPOSITORY_URL=https://github.com/pfaizar/foldex
PUBLIC_DOWNLOAD_URL=https://github.com/pfaizar/foldex/releases

# Set SITE_URL in the build environment to the final HTTPS production origin.
# Example: SITE_URL=https://your-domain.example npm run build
# Without SITE_URL, the local build deliberately omits canonical URLs and sitemaps.
